// DEV ONLY - LootBox spike S3 (ItemGrid). Opened by /lbspike ui. If this page shows,
// the document parsed; watch the client log for "Markup Error" otherwise.
$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 680, Height: 460);

  #Title {
    Group {
      $C.@Title {
        @Text = "S3 - ItemGrid";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #Status {
      Anchor: (Height: 24, Bottom: 10);
      Text: "Document parsed. Check the widget below renders and responds.";
    }

    ItemGrid #Grid {
      Anchor: (Height: 180);
      SlotsPerRow: 8;
      ShowScrollbar: true;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      RenderItemQualityBackground: true;
    }

    Group {
      FlexWeight: 1;
    }

    $C.@TextButton #CloseButton {
      @Text = "Close";
      @Anchor = (Width: 150);
    }
  }
}
