// DEV ONLY - LootBox spike S3 (NumberField). Opened by /lbspike ui. If this page shows,
// the document parsed; watch the client log for "Markup Error" otherwise.
$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 680, Height: 460);

  #Title {
    Group {
      $C.@Title {
        @Text = "S3 - NumberField";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #Status {
      Anchor: (Height: 24, Bottom: 10);
      Text: "Document parsed. Check the widget below renders and responds.";
    }

    $C.@NumberField #Num {
      @Anchor = (Width: 240);
      Value: 42.5;
    }

    Group {
      FlexWeight: 1;
    }

    $C.@TextButton #CloseButton {
      @Text = "Close";
      @Anchor = (Width: 150);
    }
  }
}
