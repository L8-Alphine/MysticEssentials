// Server Warps — master/detail with header search.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1000, Height: 660);

  #Title {
    Group {
      $C.@Title {
        @Text = "Server Warps";
      }

      $C.@HeaderSearch {}
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Master: warp list --------------------------------------------------
    Group {
      Anchor: (Width: 340);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Destinations";
        @Anchor = (Bottom: 10);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #WarpEmpty {
          Anchor: (Height: 72);
          Style: $M.@EmptyStyle;
          Text: "No warps match. Try a different search.";
          Visible: false;
        }

        Group #WarpList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Detail: selected warp ----------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 4);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      $M.@Panel {
        Anchor: (Bottom: 12);

        $M.@Section {
          @Text = "Selected Warp";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 8);
        }

        Label #WarpName {
          Anchor: (Height: 32, Bottom: 4);
          Style: $M.@DisplayStyle;
        }

        Label #WarpDescription {
          Anchor: (Bottom: 10);
          Style: $M.@BodyMutedStyle;
        }

        $M.@Hairline {
          @Anchor = (Bottom: 6);
        }

        $M.@KvRow {
          $M.@Key { @Text = "Cost"; }
          Label #WarpCost { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Visibility"; }
          Label #WarpVisibility { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "World"; }
          Label #WarpWorld { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Permission"; }
          Label #WarpPermission { FlexWeight: 1; Style: $M.@ValueWrapStyle; }
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44);

        $C.@TextButton #TeleportButton {
          @Text = "Teleport";
          @Anchor = (Width: 190, Right: 8);
        }

        $M.@Spacer {}

        $C.@SecondaryTextButton #ManageWarpButton {
          @Text = "Manage";
          @Anchor = (Width: 140);
          Visible: false;
        }
      }
    }
  }
}
