// One filter tab in the Notification Center. Appended per available filter:
//   cmd.append("#FilterRow", "MysticEssentials/NotificationFilterRow.ui")
// then the tab's text is set and the tab is bound.
//
// One tab per registered filter, so a mod that adds a "Guild" tab gets one
// without this file changing. The active tab is marked in its label text
// because per-element style is markup-only and cannot change at runtime.
$M = "MysticTheme.ui";

$M.@Tab #FilterButton {
  @Text = " ";
  @Anchor = (Width: 128, Right: 6, Bottom: 4);
}
