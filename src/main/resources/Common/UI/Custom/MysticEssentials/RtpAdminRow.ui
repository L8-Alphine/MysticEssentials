// Row template for the Random Teleport admin overview.
// Appended per profile: cmd.append("#ProfileList", "MysticEssentials/RtpAdminRow.ui").
$C = "../Common.ui";
$M = "MysticTheme.ui";

Group #Row {
  Anchor: (Height: 108, Bottom: 6);
  LayoutMode: Top;
  Padding: (Left: 14, Right: 14, Top: 10, Bottom: 10);
  Background: #0a0f16(0.38);

  Group {
    Anchor: (Height: 32, Bottom: 6);
    LayoutMode: Left;

    Label #Name {
      FlexWeight: 1;
      Style: (...$M.@RowNameStyle, FontSize: 17);
    }

    $C.@SmallSecondaryTextButton #TestButton {
      @Text = "Test";
      @Anchor = (Width: 84, Right: 6);
    }

    $C.@SmallTertiaryTextButton #ToggleButton {
      @Text = "Toggle";
      @Anchor = (Width: 96, Right: 6);
    }

    $C.@SmallTertiaryTextButton #CacheButton {
      @Text = "Clear Cache";
      @Anchor = (Width: 130);
    }
  }

  Label #World {
    Anchor: (Height: 16);
    Style: $M.@RowMetaStyle;
  }

  Label #Details {
    Anchor: (Height: 16);
    Style: $M.@RowMetaStyle;
  }

  Label #Result {
    Anchor: (Height: 16);
    Style: (...$M.@RowMetaStyle, TextColor: #e8c97a);
  }
}
