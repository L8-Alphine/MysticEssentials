// Notification Center (/notifications).
//
// Two generated lists: rows come from NotificationRow.ui and the filter tabs
// from NotificationFilterRow.ui, because which tabs exist depends on which
// mods are installed. Tabs sit ABOVE the list so the player filters before
// reading, and wrap onto a second line when several mods contribute.
//
// Layout contract: only #NotificationList is flexible; every other block has a
// fixed height, so the footer buttons always stay inside the container.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container #MysticNotificationShell {
  Anchor: (Width: 780, Height: 660);

  #Title {
    Group {
      $C.@Title #HeaderTitle {
        @Text = "Notifications";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group #FilterRow {
      LayoutMode: LeftCenterWrap;
      Anchor: (Height: 72, Bottom: 6);
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 32, Bottom: 8);

      Label #FooterCounts {
        FlexWeight: 1;
        Style: $M.@MetaStyle;
      }

      $C.@SmallSecondaryTextButton #MarkAllButton {
        @Text = "Mark All Read";
        @Anchor = (Width: 150);
      }
    }

    $M.@Well {
      FlexWeight: 1;

      Label #ListEmpty {
        Anchor: (Height: 64);
        Style: $M.@EmptyStyle;
        Visible: false;
      }

      Group #NotificationList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 12);

      $C.@SecondaryTextButton #SettingsButton {
        @Text = "Settings";
        @Anchor = (Width: 160);
      }

      $M.@Spacer {}

      $C.@TextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 150);
      }
    }
  }
}
