                    Style: $M.@RowMetaFitStyle;
                  }
                }
              }
              Group #Cell5 {
                Anchor: (Width: 124, Height: 52, Right: 6);
                LayoutMode: Full;
                Background: #0a0f16(0.45);

                Group #Hl {
                  Anchor: (Full: 0);
                  Background: #E8A93B(0.45);
                  Visible: false;
                }

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Left;
                  Padding: (Left: 6, Right: 6, Top: 6, Bottom: 6);

                  ItemSlot #Icon {
                    Anchor: (Width: 36, Height: 36, Right: 6);
                    ShowQualityBackground: true;
                    ShowQuantity: false;
                  }

                  Label #Name {
                    FlexWeight: 1;
                    Style: $M.@RowMetaFitStyle;
                  }
                }
              }
              Group #Cell6 {
                Anchor: (Width: 124, Height: 52, Right: 6);
                LayoutMode: Full;
                Background: #0a0f16(0.45);

                Group #Hl {
                  Anchor: (Full: 0);
                  Background: #E8A93B(0.45);
                  Visible: false;
                }

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Left;
                  Padding: (Left: 6, Right: 6, Top: 6, Bottom: 6);

                  ItemSlot #Icon {
