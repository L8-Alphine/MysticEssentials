// LootBox reveal (Bible v2.0 presentation adapters). The outcome is committed
// server-side before this page opens; the stage only shows it. Exactly one of
// #ReelStage, #GridStage and #QuickStage is visible. The reel's middle cell
// (#Reel3) is the marker; the server rewrites #Reel0-#Reel6 one step at a time.
// The grid lights #CellN #Hl. #RevealList is the odds catalog: every reward and
// its exact chance (LootBoxRevealRow.ui), on screen in every phase.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1000, Height: 660);

  #Title {
    Group {
      $C.@Title {
        @Text = "Opening";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #PreviewTitle {
      Anchor: (Height: 30, Bottom: 8);
      Style: $M.@DisplayStyle;
    }

    Group {
      LayoutMode: Left;
      FlexWeight: 1;

      // ----- Stage and result -------------------------------------------------
      Group {
        LayoutMode: Top;
        FlexWeight: 1;
        Anchor: (Right: 14);

        $M.@Panel {
          @Padding = 14;

          Anchor: (Height: 230);

          Group #ReelStage {
            LayoutMode: Top;
            Visible: false;

            Label {
              Anchor: (Height: 18, Bottom: 6);
              Style: $M.@HintStyle;
              Text: "The reward under the gold marker is yours. Reel spacing is not the odds; the list on the right is.";
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 112);

            Group #Reel0 {
              Anchor: (Width: 70, Height: 112, Right: 5);
              LayoutMode: Top;
              Padding: (Left: 4, Right: 4, Top: 8, Bottom: 6);
              Background: #0a0f16(0.45);

              Group {
                Anchor: (Height: 44, Bottom: 6);
                LayoutMode: CenterMiddle;

                ItemSlot #Icon {
                  Anchor: (Width: 40, Height: 40);
                  ShowQualityBackground: true;
                  ShowQuantity: false;
                }
              }

              Label #Name {
                Anchor: (Height: 36);
                Style: $M.@RowMetaFitStyle;
              }
            }
            Group #Reel1 {
              Anchor: (Width: 70, Height: 112, Right: 5);
              LayoutMode: Top;
              Padding: (Left: 4, Right: 4, Top: 8, Bottom: 6);
              Background: #0a0f16(0.45);

              Group {
                Anchor: (Height: 44, Bottom: 6);
                LayoutMode: CenterMiddle;

                ItemSlot #Icon {
                  Anchor: (Width: 40, Height: 40);
                  ShowQualityBackground: true;
                  ShowQuantity: false;
                }
              }

              Label #Name {
                Anchor: (Height: 36);
                Style: $M.@RowMetaFitStyle;
              }
            }
            Group #Reel2 {
              Anchor: (Width: 70, Height: 112, Right: 5);
              LayoutMode: Top;
              Padding: (Left: 4, Right: 4, Top: 8, Bottom: 6);
              Background: #0a0f16(0.45);

              Group {
                Anchor: (Height: 44, Bottom: 6);
                LayoutMode: CenterMiddle;

                ItemSlot #Icon {
                  Anchor: (Width: 40, Height: 40);
                  ShowQualityBackground: true;
                  ShowQuantity: false;
                }
              }

              Label #Name {
                Anchor: (Height: 36);
                Style: $M.@RowMetaFitStyle;
              }
            }
            Group #Reel3 {
              Anchor: (Width: 70, Height: 112, Right: 5);
              LayoutMode: Top;
              Padding: (Left: 4, Right: 4, Top: 8, Bottom: 6);
              Background: #3a2a10(0.85);

              Group {
                Anchor: (Height: 44, Bottom: 6);
                LayoutMode: CenterMiddle;

                ItemSlot #Icon {
                  Anchor: (Width: 40, Height: 40);
                  ShowQualityBackground: true;
                  ShowQuantity: false;
                }
              }

              Label #Name {
                Anchor: (Height: 36);
                Style: $M.@RowMetaFitStyle;
              }
            }
            Group #Reel4 {
