                  }
                }
              }
            }

            Group {
              LayoutMode: Left;
              Anchor: (Height: 52, Bottom: 6);

              Group #Cell8 {
                Anchor: (Width: 124, Height: 52, Right: 6);
                LayoutMode: Full;
                Background: #0a0f16(0.45);

                Group #Hl {
                  Anchor: (Full: 0);
                  Background: #E8A93B(0.45);
                  Visible: false;
                }

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Left;
