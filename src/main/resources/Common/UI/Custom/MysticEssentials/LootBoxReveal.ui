                    Style: $M.@RowMetaFitStyle;
                  }
                }
              }
            }

          }

          Group #QuickStage {
            LayoutMode: Top;
            Visible: false;

            Label #QuickLine {
              Anchor: (Height: 40, Top: 60);
              Style: $M.@DisplaySmallStyle;
            }
          }
        }

        $M.@Panel {
          @Padding = 14;

          Anchor: (Top: 12);

          Label #ResultName {
            Anchor: (Height: 26, Bottom: 4);
            Style: $M.@DisplaySmallStyle;
          }

          Label #ResultMeta {
            Anchor: (Bottom: 2);
            Style: $M.@MetaWrapStyle;
          }

          Label #Status {
            Anchor: (Height: 18);
            Style: $M.@MetaGoldStyle;
          }
        }
      }

      // ----- Odds catalog: always shown, never hidden -------------------------
      Group {
        LayoutMode: Top;
        Anchor: (Width: 360);

        $M.@Section {
          @Text = "Every reward and its chance";
          @Anchor = (Bottom: 6);
        }

        $M.@Well {
          FlexWeight: 1;

          Group #RevealList {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            Padding: (Right: 6);
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 8);

      $C.@SecondaryTextButton #SkipButton {
        @Text = "Skip";
        @Anchor = (Width: 140);
      }

      $M.@Spacer {}

      $C.@TextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 160);
      }
    }
  }
}
