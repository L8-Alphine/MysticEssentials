                ItemSlot #Icon {
                  Anchor: (Width: 40, Height: 40);
                  ShowQualityBackground: true;
                  ShowQuantity: false;
                }
              }

              Label #Name {
                Anchor: (Height: 36);
                Style: $M.@RowMetaFitStyle;
              }
            }
            }
          }

          Group #GridStage {
            LayoutMode: Top;
            Visible: false;

            Group {
              LayoutMode: Left;
              Anchor: (Height: 52, Bottom: 6);

              Group #Cell0 {
                Anchor: (Width: 124, Height: 52, Right: 6);
                LayoutMode: Full;
                Background: #0a0f16(0.45);

                Group #Hl {
                  Anchor: (Full: 0);
                  Background: #E8A93B(0.45);
                  Visible: false;
                }

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Left;
                  Padding: (Left: 6, Right: 6, Top: 6, Bottom: 6);

                  ItemSlot #Icon {
                    Anchor: (Width: 36, Height: 36, Right: 6);
                    ShowQualityBackground: true;
                    ShowQuantity: false;
                  }

                  Label #Name {
                    FlexWeight: 1;
                    Style: $M.@RowMetaFitStyle;
                  }
                }
              }
              Group #Cell1 {
                Anchor: (Width: 124, Height: 52, Right: 6);
                LayoutMode: Full;
                Background: #0a0f16(0.45);

                Group #Hl {
                  Anchor: (Full: 0);
                  Background: #E8A93B(0.45);
                  Visible: false;
                }

                Group {
                  Anchor: (Full: 0);
                  LayoutMode: Left;
                  Padding: (Left: 6, Right: 6, Top: 6, Bottom: 6);

                  ItemSlot #Icon {
                    Anchor: (Width: 36, Height: 36, Right: 6);
                    ShowQualityBackground: true;
                    ShowQuantity: false;
                  }

                  Label #Name {
                    FlexWeight: 1;
                    Style: $M.@RowMetaFitStyle;
                  }
