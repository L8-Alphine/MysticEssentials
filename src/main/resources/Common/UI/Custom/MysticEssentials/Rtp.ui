// Random Teleport — choose a destination profile. Each card names the world,
// the range and the cost; the teleport button is on the card itself.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 720, Height: 620);

  #Title {
    Group {
      $C.@Title {
        @Text = "Random Teleport";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Section {
      @Text = "Destinations";
      @Anchor = (Bottom: 8);
    }

    $M.@Well {
      FlexWeight: 1;

      Label #Empty {
        Anchor: (Height: 72);
        Style: $M.@EmptyStyle;
        Text: "No random teleport destinations are available to you.";
        Visible: false;
      }

      Group #ProfileList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }
  }
}
