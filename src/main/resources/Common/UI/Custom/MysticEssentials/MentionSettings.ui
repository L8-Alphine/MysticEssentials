// Per-player mention settings (/mentions).
//
// Layout contract: every block except #ScopeList has a FIXED height and
// #ScopeList takes FlexWeight: 1, which is what keeps the footer inside the
// container however many scope options installed mods contribute.
//
// The scope rows are NOT declared here: which options exist depends on which
// mods are installed, so they are appended at runtime from MentionScopeRow.ui.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container #MysticMentionShell {
  Anchor: (Width: 560, Height: 660);

  #Title {
    Group {
      $C.@Title #HeaderTitle {
        @Text = "Mention Settings";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #PageSubtitle {
      Anchor: (Height: 20, Bottom: 10);
      Style: $M.@BodyMutedStyle;
    }

    $M.@Section {
      @Text = "How you are notified";
      @Anchor = (Bottom: 8);
    }

    $M.@SettingRow #HighlightToggle { @Text = "Chat Highlighting"; @Anchor = (Bottom: 3); }
    $M.@SettingRow #SoundToggle { @Text = "Sound Notifications"; @Anchor = (Bottom: 3); }
    $M.@SettingRow #TitleToggle { @Text = "Title Notifications"; @Anchor = (Bottom: 3); }
    $M.@SettingRow #ActionBarToggle { @Text = "Action-Bar Notifications"; @Anchor = (Bottom: 14); }

    $M.@Section {
      @Text = "Who may mention you";
      @Anchor = (Bottom: 8);
    }

    // Scrolls, because the option count grows with the installed mods.
    Group #ScopeList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 6);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    $M.@Section {
      @Text = "Quiet";
      @Anchor = (Top: 10, Bottom: 8);
    }

    $M.@SettingRow #DndToggle { @Text = "Do Not Disturb"; @Anchor = (Bottom: 6); }

    Label #BlockedInfo {
      Anchor: (Height: 22, Bottom: 8);
      Style: $M.@CaptionStyle;
    }

    $M.@ActionBar {
      @Anchor = (Height: 44);

      $C.@TertiaryTextButton #ResetButton {
        @Text = "Reset Defaults";
        @Anchor = (Width: 170);
      }

      $M.@Spacer {}

      $C.@TextButton #CloseButton {
        @Text = "Done";
        @Anchor = (Width: 140);
      }
    }
  }
}
