// Edit Vault — the vault's identity on the left (name, colour, icon id, lore),
// a live icon preview and searchable item picker on the right.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 960, Height: 640);

  #Title {
    Group {
      $C.@Title #HeaderTitle {
        @Text = "Edit Vault";
      }

      $M.@HeaderMeta #Subtitle {
        @Width = 260;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ----- Identity ---------------------------------------------------------
    Group {
      Anchor: (Width: 420);
      LayoutMode: Top;

      $M.@Panel {
        Group #NameRow {
          LayoutMode: Top;
          Anchor: (Bottom: 12);

          $M.@FieldLabel { @Text = "Name"; }

          $C.@TextField #NameInput {
            PlaceholderText: "Vault name";
          }
        }

        Group #ColorRow {
          LayoutMode: Left;
          Anchor: (Height: 32, Bottom: 12);

          Label {
            Anchor: (Width: 110);
            Style: $M.@KeyStyle;
            Text: "Colour";
          }

          ColorPickerDropdownBox #ColorInput {
            Anchor: (Width: 50, Height: 32);
            Format: Rgb;
            Style: $C.@DefaultColorPickerDropdownBoxStyle;
            Color: #7a9cc6;
            DisplayTextField: true;
          }
        }

        Group #IconRow {
          LayoutMode: Top;
          Anchor: (Bottom: 12);

          $M.@FieldLabel { @Text = "Icon item id"; }

          $C.@TextField #IconInput {
            PlaceholderText: "e.g. Stone — or pick one on the right";
          }
        }

        Group #DescriptionRow {
          LayoutMode: Top;

          $M.@FieldLabel { @Text = "Description  ·  optional"; }

          $C.@TextField #DescriptionInput {
            PlaceholderText: "Lore shown on the vault card";
          }
        }
      }

      $M.@Spacer {}

      $M.@ActionBar {
        @Anchor = (Height: 44);

        $C.@TextButton #ApplyButton {
          @Text = "Apply";
          @Anchor = (Width: 140, Right: 8);
        }

        $C.@SecondaryTextButton #ResetButton {
          @Text = "Reset";
          @Anchor = (Width: 120);
        }

        $M.@Spacer {}

        $C.@TertiaryTextButton #BackButton {
          @Text = "Back";
          @Anchor = (Width: 110);
        }
      }
    }

    $M.@ColumnDivider {}

    // ----- Icon picker -------------------------------------------------------
    Group #IconPickerColumn {
      FlexWeight: 1;
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 52, Bottom: 12);

        $M.@IconWell {
          @Size = 52;
          @Anchor = (Right: 12);

          ItemSlot #IconPreview {
            Anchor: (Width: 48, Height: 48);
            ShowQualityBackground: true;
            ShowQuantity: false;
          }
        }

        Group {
          LayoutMode: Top;
          FlexWeight: 1;

          $M.@Spacer {}

          Label {
            Anchor: (Height: 16, Bottom: 4);
            Style: $M.@EyebrowGoldStyle;
            Text: "Icon Preview";
          }

          Label #IconCurrent {
            Anchor: (Height: 16);
            Style: $M.@MetaStyle;
          }

          $M.@Spacer {}
        }
      }

      $C.@TextField #IconSearch {
        @Anchor = (Bottom: 8);
        PlaceholderText: "Search items...";
      }

      $M.@Well {
        FlexWeight: 1;

        Label #IconEmpty {
          Anchor: (Height: 56);
          Style: $M.@EmptyStyle;
          Text: "No matching items.";
          Visible: false;
        }

        Group #IconResults {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }
  }
}
