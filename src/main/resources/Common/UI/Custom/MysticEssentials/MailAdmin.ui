// Mail Admin Center — compose an announcement on the left (subject, message,
// audience, rewards), review what has already been sent on the right.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1320, Height: 760);

  #Title {
    Group {
      $C.@Title {
        @Text = "Mail Admin Center";
      }

      $M.@HeaderMeta #HeaderInfo {
        @Width = 300;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ===================== Composer =====================
    Group {
      Anchor: (Width: 680);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Compose Announcement";
        @Style = $M.@EyebrowGoldStyle;
        @Anchor = (Bottom: 10);
      }

      $M.@FieldLabel { @Text = "Subject"; }

      $C.@TextField #SubjectInput {
        @Anchor = (Bottom: 10);
        PlaceholderText: "Announcement title...";
      }

      $M.@FieldLabel { @Text = "Message"; }

      $C.@MultilineTextField #BodyInput {
        @Anchor = (Height: 130, Bottom: 10);
        PlaceholderText: "Write your announcement...";
      }

      $M.@FieldLabel { @Text = "Audience"; }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 6);

        $M.@Tab #AudOnline { @Text = "Online"; @Anchor = (Width: 110, Right: 4); }
        $M.@Tab #AudKnown { @Text = "All Known"; @Anchor = (Width: 130, Right: 4); }
        $M.@Tab #AudPermission { @Text = "Permission"; @Anchor = (Width: 140, Right: 4); }
        $M.@Tab #AudPlayer { @Text = "One Player"; @Anchor = (Width: 140); }
      }

      Label #AudienceLabel {
        Anchor: (Height: 16, Bottom: 6);
        Style: $M.@MetaGoldStyle;
      }

      $C.@TextField #ParamInput {
        @Anchor = (Bottom: 10);
        PlaceholderText: "Permission node or player name";
        Visible: false;
      }

      Label #CommandLabel {
        Anchor: (Height: 16, Bottom: 6);
        Style: $M.@EyebrowStyle;
        Text: "Reward commands  ·  separate with ;  ·  {player} {uuid}";
      }

      $C.@TextField #CommandInput {
        @Anchor = (Bottom: 10);
        PlaceholderText: "give {player} 1 Diamond; xp add {player} 100";
      }

      Label #RewardHeader {
        Anchor: (Height: 16, Bottom: 6);
        Style: $M.@EyebrowGoldStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 10);

        $C.@TextField #PickerSearch {
          @Anchor = (Vertical: 3, Right: 8);
          FlexWeight: 1;
          PlaceholderText: "Search the item registry...";
        }

        $C.@SecondaryTextButton #SearchButton {
          @Text = "Search";
          @Anchor = (Width: 104, Right: 8);
        }

        Label {
          Anchor: (Width: 30, Height: 44);
          Style: $M.@EyebrowStyle;
          Text: "Qty";
        }

        $C.@TextField #QtyInput {
          @Anchor = (Vertical: 3, Width: 56, Right: 8);
          Value: "1";
        }

        $C.@TertiaryTextButton #ClearRewardsButton {
          @Text = "Clear";
          @Anchor = (Width: 90);
        }
      }

      Group {
        FlexWeight: 1;
        LayoutMode: Left;

        Group {
          Anchor: (Width: 310, Right: 12);
          LayoutMode: Top;

          Label {
            Anchor: (Height: 16, Bottom: 6);
            Style: $M.@EyebrowStyle;
            Text: "Results  ·  click to attach";
          }

          $M.@Well {
            FlexWeight: 1;

            Label #NoItemsLabel {
              Anchor: (Height: 40);
              Style: $M.@EmptyStyle;
              Visible: false;
            }

            Group #PickerList {
              FlexWeight: 1;
              LayoutMode: TopScrolling;
              Padding: (Right: 6);
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
            }
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #DraftLabel {
            Anchor: (Height: 16, Bottom: 6);
            Style: $M.@EyebrowStyle;
          }

          $M.@Well {
            FlexWeight: 1;

            Group #DraftList {
              FlexWeight: 1;
              LayoutMode: TopScrolling;
              Padding: (Right: 6);
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
            }
          }
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44, Top: 10);

        $C.@TertiaryTextButton #CancelButton {
          @Text = "Close";
          @Anchor = (Width: 110);
        }

        $M.@Spacer {}

        $C.@TextButton #SendButton {
          @Text = "Send Announcement";
          @Anchor = (Width: 210);
        }
      }
    }

    $M.@ColumnDivider {}

    // ===================== History =====================
    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      $M.@Section {
        @Text = "Sent Announcements";
        @Anchor = (Bottom: 10);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #HistoryEmpty {
          Anchor: (Height: 64);
          Style: $M.@EmptyStyle;
          Text: "Nothing has been sent yet.";
          Visible: false;
        }

        Group #HistoryList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }
  }
}
