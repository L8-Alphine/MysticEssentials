$C = "../Common.ui";

// Row template for the channel roster (compact + expanded). Appended per member:
//   cmd.append("#MemberList", "MysticEssentials/ChannelMemberRow.ui")
// and populated by index: cmd.set("#MemberList[i] #Name.TextSpans", ...).

Button #Row {
  Anchor: (Height: 52, Bottom: 6);
  LayoutMode: Left;
  Padding: (Left: 10, Right: 10, Top: 6, Bottom: 6);
  Style: (
    Default: (Background: #000000(0.18)),
    Hovered: (Background: #7a9cc6(0.18)),
    Pressed: (Background: #7a9cc6(0.28))
  );

  Group #Swatch {
    Anchor: (Width: 8, Height: 40, Right: 10);
    Background: #7a9cc6;
  }

  Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Label #Name {
      Anchor: (Height: 20, Bottom: 2);
      Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
    }

    Label #Sub {
      Anchor: (Height: 16);
      Style: (FontSize: 12, TextColor: #9fb0c4, VerticalAlignment: Center);
    }
  }

  Group #TagChip {
    Anchor: (Width: 84, Height: 24, Left: 8);
    Background: #7a9cc6;
    Padding: (Left: 8, Right: 8);

    Label #Tag {
      FlexWeight: 1;
      Style: (FontSize: 12, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
    }
  }

  Label #Secondary {
    Anchor: (Width: 54, Height: 24, Left: 6);
    Style: (FontSize: 11, TextColor: #D46A6A, RenderBold: true, VerticalAlignment: Center);
    Visible: false;
  }
}
