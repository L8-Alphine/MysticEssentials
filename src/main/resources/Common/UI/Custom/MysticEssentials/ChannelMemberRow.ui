// Row template for the channel roster (compact + expanded). Appended per member:
//   cmd.append("#MemberList", "MysticEssentials/ChannelMemberRow.ui")
// and populated by index: cmd.set("#MemberList[i] #Name.TextSpans", ...).
// #Swatch and #TagChip are recoloured by the server; #Secondary is an optional
// second tag (muted / banned) shown only when it applies.
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 52, Bottom: 4);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 12, Right: 12, Top: 8, Bottom: 8);

    $M.@IconWell {
      @Anchor = (Right: 12);

      Group #Swatch {
        Anchor: (Width: 12, Height: 12);
        Background: #7a9cc6;
      }
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;

      Label #Name {
        Anchor: (Height: 20, Bottom: 2);
        Style: $M.@RowNameStyle;
      }

      Label #Sub {
        Anchor: (Height: 14);
        Style: $M.@RowMetaStyle;
      }
    }

    // Primary tag: authority / rank. Colour comes from the server.
    Group #TagChip {
      Anchor: (Width: 84, Height: 18, Top: 9, Left: 8);
      Background: #7a9cc6;
      Padding: (Horizontal: 6);
      LayoutMode: CenterMiddle;

      Label #Tag {
        FlexWeight: 1;
        Style: $M.@PillStyle;
      }
    }

    Label #Secondary {
      Anchor: (Width: 58, Height: 36, Left: 6);
      Style: (...$M.@PillStyle, TextColor: #D46A6A, HorizontalAlignment: End);
      Visible: false;
    }
  }
}
