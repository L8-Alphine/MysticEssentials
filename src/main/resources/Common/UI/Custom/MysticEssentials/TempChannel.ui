// Create Temporary Channel — a short form. Name is the only required field;
// everything optional is labelled as such.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 560, Height: 560);

  #Title {
    Group {
      $C.@Title {
        @Text = "Create Temporary Channel";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #Subtitle {
      Anchor: (Height: 20, Bottom: 12);
      Style: $M.@CaptionStyle;
    }

    $M.@Panel {
      Anchor: (Bottom: 14);

      $M.@FieldLabel { @Text = "Name"; }
      $C.@TextField #TempNameInput {
        @Anchor = (Bottom: 14);
        PlaceholderText: "e.g. event";
      }

      $M.@FieldLabel { @Text = "Password  ·  optional"; }
      $C.@TextField #TempPasswordInput {
        @Anchor = (Bottom: 14);
        PlaceholderText: "Leave blank for an open channel";
      }

      $M.@FieldLabel { @Text = "Prefix  ·  optional"; }
      $C.@TextField #TempPrefixInput {
        @Anchor = (Bottom: 14);
        PlaceholderText: "e.g. &b[EVENT]";
      }

      $M.@FieldLabel { @Text = "Aliases  ·  optional"; }
      $C.@TextField #TempAliasesInput {
        PlaceholderText: "comma, separated, aliases";
      }
    }

    $M.@Spacer {}

    $M.@ActionBar #TempButtons {
      @Anchor = (Height: 44);

      $C.@TertiaryTextButton #CancelTempButton {
        @Text = "Cancel";
        @Anchor = (Width: 130);
      }

      $M.@Spacer {}

      $C.@TextButton #CreateTempButton {
        @Text = "Create Channel";
        @Anchor = (Width: 190);
      }
    }
  }
}
