// Row template for the mail list. Appended per message:
//   cmd.append("#MailList", "MysticEssentials/MailRow.ui").
// The row root is a Button so the whole row is clickable (select + mark read).
// #Unread carries the dot for unread mail; #RewardIcon shows when an attachment
// is waiting; #Reward summarises it on the right.
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 58, Bottom: 4);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 10, Right: 12, Top: 9, Bottom: 9);

    $M.@IconWell {
      @Size = 40;
      @Anchor = (Right: 12);

      ItemSlot #RewardIcon {
        Anchor: (Width: 36, Height: 36);
        ShowQualityBackground: true;
        ShowQuantity: false;
        Visible: false;
      }
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 20, Bottom: 2);

        Label #Unread {
          Anchor: (Width: 14);
          Style: (...$M.@RowNameStyle, TextColor: #ffd97a);
        }

        Label #From {
          FlexWeight: 1;
          Style: $M.@RowNameStyle;
        }
      }

      Label #Preview {
        Anchor: (Height: 14);
        Style: $M.@RowMetaStyle;
      }
    }

    Group {
      Anchor: (Width: 90, Left: 6);
      LayoutMode: Top;

      Label #Date {
        Anchor: (Height: 20, Bottom: 2);
        Style: (...$M.@RowSideStyle, FontSize: 11);
      }

      Label #Reward {
        Anchor: (Height: 14);
        Style: (...$M.@RowSideGoldStyle, FontSize: 11);
      }
    }
  }
}
