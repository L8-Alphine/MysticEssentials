// Vault Manager — a tabbed dashboard. My Vaults (default) is a searchable,
// sortable list; Settings and Admin swap the body. The active tab is the one
// with the gold rule underneath, toggled by the server.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1040, Height: 700);

  #Title {
    Group {
      $C.@Title #HeaderTitle {
        @Text = "Vault Manager";
      }

      $M.@HeaderMeta #VaultCount {
        @Width = 240;
      }
    }
  }

  #Content {
    LayoutMode: Top;

    // ---------- Tab strip ----------
    Group #TabBar {
      LayoutMode: Left;
      Anchor: (Height: 40, Bottom: 14);

      Button #TabMyVaults {
        Anchor: (Width: 150, Right: 4);
        LayoutMode: Top;
        Style: $M.@TabStyle;

        Label {
          FlexWeight: 1;
          Style: $M.@TabLabelStyle;
          Text: "My Vaults";
        }

        Group #TabMyVaultsAccent {
          Anchor: (Height: 3);
          Background: #E8A93B;
        }
      }

      Button #TabSettings {
        Anchor: (Width: 150, Right: 4);
        LayoutMode: Top;
        Style: $M.@TabStyle;

        Label {
          FlexWeight: 1;
          Style: $M.@TabLabelStyle;
          Text: "Settings";
        }

        Group #TabSettingsAccent {
          Anchor: (Height: 3);
          Background: #E8A93B;
          Visible: false;
        }
      }

      Button #TabAdmin {
        Anchor: (Width: 150);
        LayoutMode: Top;
        Style: $M.@TabStyle;

        Label {
          FlexWeight: 1;
          Style: (...$M.@TabLabelStyle, TextColor: #e8c97a);
          Text: "Admin";
        }

        Group #TabAdminAccent {
          Anchor: (Height: 3);
          Background: #E8A93B;
          Visible: false;
        }
      }

      $M.@Spacer {}
    }

    // ---------- My Vaults: toolbar ----------
    Group #Toolbar {
      LayoutMode: Left;
      Anchor: (Height: 44, Bottom: 12);

      $C.@TextField #SearchInput {
        @Anchor = (Vertical: 3, Right: 8, Width: 340);
        PlaceholderText: "Search by name or number...";
      }

      $C.@SecondaryTextButton #SearchButton {
        @Text = "Search";
        @Anchor = (Width: 110, Right: 6);
      }

      $C.@TertiaryTextButton #ClearButton {
        @Text = "Clear";
        @Anchor = (Width: 90);
      }

      $M.@Spacer {}

      Label {
        Anchor: (Width: 44, Height: 44, Right: 8);
        Style: $M.@EyebrowStyle;
        Text: "Sort";
      }

      $C.@DropdownBox #SortBox {
        Anchor: (Width: 220, Height: 32, Top: 6);
      }
    }

    Label #VaultEmpty {
      Anchor: (Height: 72);
      Style: $M.@EmptyStyle;
      Text: "No vaults match your search.";
      Visible: false;
    }

    // Carries its own well background: the server hides this list when another
    // tab is active, so a wrapper would linger as an empty box.
    Group #VaultList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Background: $M.@WellBackground;
      Padding: (Full: 6);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    // ---------- Settings panel ----------
    Group #SettingsPanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Visible: false;

      $M.@Panel {
        $M.@Section {
          @Text = "Your Vault Allowance";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 10);
        }

        Label #SetAllowance {
          Anchor: (Height: 22, Bottom: 2);
          Style: $M.@ValueStyle;
        }

        Label #SetUsage {
          Anchor: (Height: 22, Bottom: 2);
          Style: $M.@ValueStyle;
        }

        Label #SetCustom {
          Anchor: (Height: 22, Bottom: 10);
          Style: $M.@ValueStyle;
        }

        $M.@Hairline {
          @Anchor = (Bottom: 10);
        }

        Label #SetHint {
          Anchor: (Height: 60);
          Style: $M.@CaptionStyle;
        }
      }
    }

    // ---------- Admin panel ----------
    Group #AdminPanel {
      FlexWeight: 1;
      LayoutMode: Top;
      Visible: false;

      $M.@Panel {
        $M.@Section {
          @Text = "Inspect Another Player";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 10);
        }

        $M.@FieldLabel { @Text = "Player  ·  must be online"; }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 10);

          $C.@TextField #AdminPlayerInput {
            @Anchor = (Vertical: 3, Right: 8, Width: 340);
            PlaceholderText: "Player name...";
          }

          $C.@TextButton #AdminViewButton {
            @Text = "View Vaults";
            @Anchor = (Width: 160);
          }
        }

        Label #AdminHint {
          Anchor: (Height: 60);
          Style: $M.@CaptionStyle;
        }
      }
    }
  }
}
