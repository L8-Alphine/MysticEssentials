// Removal line (red) in the Patch Notes viewer content.
//   cmd.append("#SectionContent", "MysticEssentials/PatchLineRemove.ui")
//   cmd.set("#SectionContent[i] #Line.TextSpans", ...)
$M = "MysticTheme.ui";

Group #Row {
  LayoutMode: Left;
  Anchor: (Height: 20);
  Padding: (Left: 12);

  // Hidden on a wrapped line, so each item has one marker.
  Label #Marker {
    Anchor: (Width: 16);
    Style: (FontSize: 14, RenderBold: true, TextColor: #e48786, VerticalAlignment: Center);
    Text: "-";
  }

  Label #Line {
    FlexWeight: 1;
    Style: (FontSize: 14, TextColor: #e3a3a3, VerticalAlignment: Center);
  }
}
