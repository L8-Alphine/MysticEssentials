// Random Teleport Admin — overview of every profile with test / toggle / cache
// controls on each card.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 840, Height: 640);

  #Title {
    Group {
      $C.@Title {
        @Text = "Random Teleport Admin";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #Summary {
      Anchor: (Height: 20, Bottom: 10);
      Style: $M.@MetaStyle;
    }

    $M.@Section {
      @Text = "Profiles";
      @Anchor = (Bottom: 8);
    }

    $M.@Well {
      FlexWeight: 1;

      Label #Empty {
        Anchor: (Height: 72);
        Style: $M.@EmptyStyle;
        Text: "No profiles configured. Edit modules/teleportation/rtp.json.";
        Visible: false;
      }

      Group #ProfileList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }
  }
}
