// Category filter tab for the Patch Notes viewer. Appended per filter:
//   cmd.append("#FilterBar", "MysticEssentials/PatchFilterButton.ui")
// then: cmd.set("#FilterBar[i] #Label.TextSpans", ...) and toggle the active
// rule via cmd.set("#FilterBar[i] #Active.Visible", true).
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Width: 118, Right: 6);
  LayoutMode: Top;
  Style: $M.@TabStyle;

  Group {
    FlexWeight: 1;

    Label #Label {
      Anchor: (Full: 0);
      Style: $M.@TabLabelStyle;
    }
  }

  Group #Active {
    Anchor: (Height: 3);
    Background: #E8A93B;
    Visible: false;
  }
}
