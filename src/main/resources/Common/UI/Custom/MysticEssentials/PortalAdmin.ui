// Portal — configure one portal block. The form is grouped by concern:
// identity, destination (world / server / commands — the server shows the one
// that matches the chosen type), access, and map marker. The whole form
// scrolls; Save and Delete stay fixed at the foot.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 660, Height: 720);

  #Title {
    Group {
      $C.@Title {
        @Text = "Portal";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 6);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      // ---- Identity --------------------------------------------------------
      $M.@Panel {
        Anchor: (Bottom: 12);

        Label #PortalHeading {
          Anchor: (Height: 30, Bottom: 2);
          Style: $M.@DisplayStyle;
        }

        Label #PortalMeta {
          Anchor: (Height: 16, Bottom: 12);
          Style: $M.@CaptionStyle;
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            FlexWeight: 1;
            Style: $M.@EyebrowStyle;
            Text: "Display name  ·  optional";
          }

          Label {
            Anchor: (Width: 220);
            Style: $M.@EyebrowStyle;
            Text: "Type";
          }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 38);

          $C.@TextField #PortalName {
            @Anchor = (Right: 8);
            FlexWeight: 1;
            PlaceholderText: "Shown on the marker and in messages";
          }

          $C.@DropdownBox #PortalType {
            Anchor: (Width: 220, Height: 32, Top: 3);
          }
        }
      }

      // ---- Destination -----------------------------------------------------
      $M.@Panel {
        Anchor: (Bottom: 12);

        $M.@Section {
          @Text = "Destination";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 10);
        }

        Group #WorldSection {
          LayoutMode: Top;

          $M.@FieldLabel { @Text = "Target world"; }

          $C.@TextField #TargetWorld {
            @Anchor = (Bottom: 10);
            PlaceholderText: "World name";
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 44, Bottom: 8);

            $C.@SecondaryTextButton #UseLocationToggle {
              @Text = "Exact location: OFF";
              @Anchor = (Width: 220, Right: 8);
            }

            $C.@SmallTertiaryTextButton #HereButton {
              @Text = "Use my position";
              @Anchor = (Width: 160, Vertical: 6);
            }
          }

          Group #LocationRow {
            LayoutMode: Left;
            Anchor: (Height: 38);

            $C.@TextField #PosX {
              @Anchor = (Width: 100, Right: 8);
              PlaceholderText: "X";
            }

            $C.@TextField #PosY {
              @Anchor = (Width: 100, Right: 8);
              PlaceholderText: "Y";
            }

            $C.@TextField #PosZ {
              @Anchor = (Width: 100, Right: 8);
              PlaceholderText: "Z";
            }

            $C.@DropdownBox #Facing {
              Anchor: (Width: 170, Height: 32, Top: 3);
            }
          }
        }

        Group #ServerSection {
          LayoutMode: Top;

          $M.@FieldLabel { @Text = "Server"; }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 38);

            $C.@TextField #Host {
              @Anchor = (Right: 8);
              FlexWeight: 1;
              PlaceholderText: "Host";
            }

            $C.@TextField #Port {
              @Anchor = (Width: 130);
              PlaceholderText: "Port";
            }
          }
        }

        Group #CommandSection {
          LayoutMode: Top;

          $M.@FieldLabel { @Text = "Commands  ·  separate with ;  ·  wait <ticks> pauses"; }

          $C.@TextField #Command {
            @Anchor = (Bottom: 10);
            PlaceholderText: "spawn {PlayerUsername}; wait 20; give {PlayerUsername} torch";
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32);

            Label {
              Anchor: (Width: 110);
              Style: $M.@KeyStyle;
              Text: "Run as";
            }

            $C.@DropdownBox #CommandSender {
              Anchor: (Width: 220, Height: 32);
            }
          }
        }
      }

      // ---- Access & marker -------------------------------------------------
      $M.@Panel {
        $M.@Section {
          @Text = "Access";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 10);
        }

        $M.@FieldLabel { @Text = "Required permission  ·  empty = everyone"; }

        $C.@TextField #Permission {
          @Anchor = (Bottom: 14);
          PlaceholderText: "e.g. mysticessentials.portal.vip";
        }

        $M.@Section {
          @Text = "Map Marker";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 10);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 8);

          $C.@SecondaryTextButton #MarkerToggle {
            @Text = "Map marker: OFF";
            @Anchor = (Width: 220);
          }
        }

        Group #MarkerRow {
          LayoutMode: Left;
          Anchor: (Height: 38);

          $C.@TextField #MarkerText {
            @Anchor = (Right: 8);
            FlexWeight: 1;
            PlaceholderText: "Marker label";
          }

          $C.@TextField #MarkerIcon {
            @Anchor = (Width: 200);
            PlaceholderText: "Icon (Portal.png)";
          }
        }
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 12);

      $C.@TertiaryTextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 110, Right: 8);
      }

      $C.@CancelTextButton #DeletePortalButton {
        @Text = "Delete";
        @Anchor = (Width: 120);
      }

      $M.@Spacer {}

      $C.@TextButton #SaveButton {
        @Text = "Save Portal";
        @Anchor = (Width: 180);
      }
    }
  }
}
