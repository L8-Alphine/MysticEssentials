// My Player Warps — the owner's manager. Master list of their warps; the detail
// panel edits the selected one. Delete is isolated at the end of the action bar.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 940, Height: 660);

  #Title {
    Group {
      $C.@Title {
        @Text = "My Player Warps";
      }

      $M.@HeaderMeta #ManagerLimit {
        @Width = 180;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Master: own warps --------------------------------------------------
    Group {
      Anchor: (Width: 300);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Your Warps";
        @Anchor = (Bottom: 10);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #OwnEmpty {
          Anchor: (Height: 72);
          Style: $M.@EmptyStyle;
          Text: "You have no player warps. Use /pwarp create <name> where you stand.";
          Visible: false;
        }

        Group #OwnList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Detail: edit selected ----------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 4);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      $M.@Panel {
        Anchor: (Bottom: 12);

        $M.@Section {
          @Text = "Selected Warp";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 8);
        }

        Label #SelectedName {
          Anchor: (Height: 32, Bottom: 10);
          Style: $M.@DisplayStyle;
        }

        $M.@Hairline {
          @Anchor = (Bottom: 12);
        }

        $M.@FieldLabel {
          @Text = "Description";
        }

        $C.@TextField #EditDescription {
          @Anchor = (Bottom: 12);
          PlaceholderText: "What will visitors find here?";
        }

        $M.@FieldLabel {
          @Text = "Visit Cost";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 12);

          $C.@TextField #EditCost {
            @Anchor = (Vertical: 3, Width: 140, Right: 8);
            PlaceholderText: "0";
          }

          $M.@Spacer {}

          $C.@SecondaryTextButton #SaveDetailsButton {
            @Text = "Save Details";
            @Anchor = (Width: 160);
          }
        }

        $M.@FieldLabel {
          @Text = "Rename";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44);

          $C.@TextField #RenameInput {
            @Anchor = (Vertical: 3, Right: 8);
            FlexWeight: 1;
            PlaceholderText: "New name";
          }

          $C.@SecondaryTextButton #RenameButton {
            @Text = "Rename";
            @Anchor = (Width: 130);
          }
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44, Bottom: 18);

        $C.@TextButton #TeleportButton {
          @Text = "Teleport";
          @Anchor = (Width: 160, Right: 8);
        }

        $C.@SecondaryTextButton #MoveHereButton {
          @Text = "Move Here";
          @Anchor = (Width: 150);
        }

        $M.@Spacer {}

        $C.@CancelTextButton #DeleteButton {
          @Text = "Delete";
          @Anchor = (Width: 120);
        }
      }

      $M.@Section {
        @Text = "Everyone's Warps";
        @Anchor = (Bottom: 8);
      }

      $M.@ActionBar {
        @Anchor = (Height: 44);

        $C.@TertiaryTextButton #BrowseAllButton {
          @Text = "Browse All Player Warps";
          @Anchor = (Width: 260);
        }
      }
    }
  }
}
