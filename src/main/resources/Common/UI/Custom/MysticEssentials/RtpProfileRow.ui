// Card template for the Random Teleport selection UI.
// Appended per profile: cmd.append("#ProfileList", "MysticEssentials/RtpProfileRow.ui").
$C = "../Common.ui";
$M = "MysticTheme.ui";

Group #Row {
  Anchor: (Height: 104, Bottom: 6);
  LayoutMode: Left;
  Padding: (Left: 0, Right: 14, Top: 12, Bottom: 12);
  Background: #0a0f16(0.38);

  Group {
    Anchor: (Width: 3, Height: 80, Right: 13);
    Background: #7a9cc6;
  }

  Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Label #Name {
      Anchor: (Height: 24, Bottom: 4);
      Style: (...$M.@RowNameStyle, FontSize: 17);
    }

    Label #World {
      Anchor: (Height: 16, Bottom: 2);
      Style: $M.@RowMetaStyle;
    }

    Label #Details {
      Anchor: (Height: 16, Bottom: 2);
      Style: $M.@RowMetaStyle;
    }

    Label #Status {
      Anchor: (Height: 16);
      Style: (...$M.@RowMetaStyle, TextColor: #6fd08c);
    }
  }

  Group {
    LayoutMode: Top;
    Anchor: (Width: 150, Left: 12);

    $M.@Spacer {}

    $C.@TextButton #TeleportButton {
      @Text = "Teleport";
    }

    $M.@Spacer {}
  }
}
