// Manage Temporary Channel — edit the owner's channel. Closing the channel is
// destructive and sits alone at the end, away from Save.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 560, Height: 540);

  #Title {
    Group {
      $C.@Title {
        @Text = "Manage Temporary Channel";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Panel {
      Anchor: (Bottom: 14);

      $M.@Section {
        @Text = "Your Channel";
        @Style = $M.@EyebrowGoldStyle;
        @Anchor = (Bottom: 8);
      }

      Label #ManageChannelName {
        Anchor: (Height: 30, Bottom: 2);
        Style: $M.@DisplayStyle;
      }

      Label #ManageExpiry {
        Anchor: (Height: 16, Bottom: 12);
        Style: $M.@MetaStyle;
      }

      $M.@Hairline {
        @Anchor = (Bottom: 12);
      }

      $M.@FieldLabel { @Text = "Password  ·  blank keeps it open"; }
      $C.@TextField #ManagePasswordInput {
        @Anchor = (Bottom: 14);
        PlaceholderText: "No password";
      }

      $M.@FieldLabel { @Text = "Prefix"; }
      $C.@TextField #ManagePrefixInput {
        PlaceholderText: "e.g. &b[EVENT]";
      }
    }

    $M.@Spacer {}

    $M.@ActionBar {
      @Anchor = (Height: 44, Bottom: 10);

      $C.@TertiaryTextButton #BackToChannelsButton {
        @Text = "Back";
        @Anchor = (Width: 110, Right: 8);
      }

      $M.@Spacer {}

      $C.@TextButton #SaveChannelButton {
        @Text = "Save Changes";
        @Anchor = (Width: 180);
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44);

      $M.@Spacer {}

      $C.@CancelTextButton #CloseChannelButton {
        @Text = "Close Channel";
        @Anchor = (Width: 180);
      }
    }
  }
}
