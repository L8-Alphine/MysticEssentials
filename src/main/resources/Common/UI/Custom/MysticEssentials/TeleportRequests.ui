// Teleport Requests — people on the left (favourites pinned above everyone
// online), incoming requests on the right where they need an answer.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 960, Height: 640);

  #Title {
    Group {
      $C.@Title {
        @Text = "Teleport Requests";
      }

      $C.@HeaderSearch {}
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- People -------------------------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      $M.@Section {
        @Text = "Favourites";
        @Style = $M.@EyebrowGoldStyle;
        @Anchor = (Bottom: 8);
      }

      $M.@Well {
        Anchor: (Height: 176, Bottom: 14);

        Label #FavoritesEmpty {
          Anchor: (Height: 48);
          Style: $M.@EmptyStyle;
          Text: "No favourites yet. Star a player below to keep them here.";
          Visible: false;
        }

        Group #FavoriteList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      $M.@Section {
        @Text = "Online Players";
        @Anchor = (Bottom: 8);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #PlayersEmpty {
          Anchor: (Height: 64);
          Style: $M.@EmptyStyle;
          Text: "Nobody else is online right now.";
          Visible: false;
        }

        Group #PlayerList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Incoming -----------------------------------------------------------
    Group {
      Anchor: (Width: 340);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Incoming Requests";
        @Anchor = (Bottom: 8);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #RequestsEmpty {
          Anchor: (Height: 64);
          Style: $M.@EmptyStyle;
          Text: "No pending requests.";
          Visible: false;
        }

        Group #RequestList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }
  }
}
