// Server Wiki — one window for finding and reading. Search, categories and the
// page list on the left; the open page on the right, with its icon, the
// rendered body (WikiLine.ui per block) and its links.
//
// Stored articles and pages contributed by other mods sit in the same list: a
// reader should not have to care which mod wrote a page.
//
// 1050 x 700 is the largest page vanilla draws; nothing here grows past it.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1050, Height: 700);

  #Title {
    Group {
      $C.@Title {
        @Text = "Server Wiki";
      }

      $M.@HeaderMeta #WikiCount {}
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Finding a page ------------------------------------------------------
    Group {
      Anchor: (Width: 300);
      LayoutMode: Top;

      Label #WikiSubtitle {
        Anchor: (Height: 18, Bottom: 6);
        Style: $M.@HintStyle;
      }

      $C.@TextField #SearchInput {
        @Anchor = (Height: 34, Bottom: 10);
        PlaceholderText: "Search the wiki";
      }

      $M.@Section {
        @Text = "Categories";
        @Anchor = (Bottom: 6);
      }

      Group #CategoryList {
        Anchor: (Height: 150, Bottom: 10);
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      $M.@Section {
        @Text = "Pages";
        @Anchor = (Bottom: 6);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #WikiEmpty {
          Anchor: (Height: 70);
          Style: $M.@EmptyStyle;
          Visible: false;
        }

        Group #ArticleList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      $C.@SecondaryTextButton #NewArticleButton {
        @Text = "New Page";
        @Anchor = (Top: 10);
        Visible: false;
      }
    }

    $M.@ColumnDivider {}

    // ---- Reading it ----------------------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Group {
        Anchor: (Height: 56, Bottom: 8);
        LayoutMode: Left;

        $M.@IconWell {
          @Size = 56;
          @Anchor = (Right: 14);

          AssetImage #ArticleIcon {
            Anchor: (Width: 46, Height: 46);
            AssetPath: "";
            FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
            Visible: false;
          }

          ItemSlot #ArticleItem {
            Anchor: (Width: 52, Height: 52);
            ShowQualityBackground: true;
            ShowQuantity: false;
            Visible: false;
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          Label #ArticleTitle {
            Anchor: (Height: 30, Top: 2);
            Style: $M.@DisplayStyle;
          }

          Label #ArticleSummary {
            Anchor: (Height: 20);
            Style: $M.@HintStyle;
          }
        }

        Label #ArticleCategory {
          Anchor: (Width: 200);
          Style: $M.@RowSideGoldStyle;
        }
      }

      $M.@Hairline {
        @Anchor = (Bottom: 8);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #ArticleEmpty {
          Anchor: (Height: 80);
          Style: $M.@EmptyStyle;
          Text: "This page has nothing written on it yet.";
          Visible: false;
        }

        // One WikiLine.ui per rendered block of the body.
        Group #ArticleBody {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 10, Left: 6, Top: 4);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      // Links written inside the text, as buttons (a text line cannot hold one).
      Group #RelatedSection {
        Anchor: (Height: 34, Top: 8);
        LayoutMode: Left;
        Visible: false;

        Label {
          Anchor: (Width: 52);
          Style: $M.@EyebrowStyle;
          Text: "Links";
        }

        Group #RelatedList {
          FlexWeight: 1;
          LayoutMode: Left;
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44, Top: 10);

        $C.@TextButton #EditButton {
          @Text = "Edit";
          @Anchor = (Width: 120, Right: 8);
          Visible: false;
        }

        $C.@TertiaryTextButton #MenuButton {
          @Text = "Main Menu";
          @Anchor = (Width: 150);
        }

        $M.@Spacer {}

        Label #ArticleFooter {
          Anchor: (Width: 300, Right: 12);
          Style: (...$M.@HeaderMetaStyle, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9);
        }

        $C.@CancelTextButton #CloseButton {
          @Text = "Close";
          @Anchor = (Width: 120);
        }
      }
    }
  }
}
