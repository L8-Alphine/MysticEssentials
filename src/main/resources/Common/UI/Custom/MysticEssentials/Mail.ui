// Mail — a three-pane client: folders, the message list, and the reading /
// compose pane. The reading pane is laid out like a letter (subject, from,
// date, rule, body) with rewards and actions at the foot.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1240, Height: 740);

  #Title {
    Group {
      $C.@Title {
        @Text = "Mail";
      }

      $M.@HeaderMeta #HeaderInfo {
        @Width = 260;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ===================== Folders =====================
    Group {
      Anchor: (Width: 200);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Folders";
        @Anchor = (Bottom: 10);
      }

      Group #NavTop {
        LayoutMode: Top;
        Anchor: (Bottom: 10);
      }

      $M.@Hairline {
        @Anchor = (Bottom: 10);
      }

      Group #NavBottom {
        LayoutMode: Top;
      }

      $M.@Spacer {}

      Label {
        Anchor: (Height: 16);
        Style: $M.@CaptionStyle;
        Text: "Mystic Essentials";
      }
    }

    $M.@ColumnDivider {}

    // ===================== Message list =====================
    Group {
      Anchor: (Width: 380);
      LayoutMode: Top;

      Label #ListTitle {
        Anchor: (Height: 16, Bottom: 10);
        Style: $M.@EyebrowGoldStyle;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 8);

        $C.@TextField #SearchInput {
          @Anchor = (Vertical: 3, Right: 8);
          FlexWeight: 1;
          PlaceholderText: "Search mail...";
        }

        $C.@SecondaryTextButton #SearchButton {
          @Text = "Search";
          @Anchor = (Width: 104);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 8);

        Label #PageInfo {
          FlexWeight: 1;
          Style: $M.@MetaStyle;
        }

        $C.@SmallTertiaryTextButton #PrevButton {
          @Text = "<";
          @Anchor = (Width: 36, Right: 4);
        }

        Label #PageLabel {
          Anchor: (Width: 40, Height: 32);
          Style: (...$M.@ValueStyle, HorizontalAlignment: Center);
        }

        $C.@SmallTertiaryTextButton #NextButton {
          @Text = ">";
          @Anchor = (Width: 36, Left: 4);
        }
      }

      $M.@Well {
        FlexWeight: 1;

        Label #ListEmpty {
          Anchor: (Height: 64);
          Style: $M.@EmptyStyle;
          Visible: false;
        }

        Group #MailList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      $C.@SecondaryTextButton #MarkAllButton {
        @Text = "Mark All As Read";
        @Anchor = (Top: 10);
      }
    }

    $M.@ColumnDivider {}

    // ===================== Right pane =====================
    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      // ----- Reading pane -----
      Group #ReadPane {
        FlexWeight: 1;
        LayoutMode: Top;

        Label #ReadSubject {
          Anchor: (Height: 32, Bottom: 4);
          Style: $M.@DisplayStyle;
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 10);

          Label #ReadFrom {
            FlexWeight: 1;
            Style: $M.@MetaStyle;
          }

          Label #ReadDate {
            Anchor: (Width: 220);
            Style: (...$M.@MetaStyle, HorizontalAlignment: End);
          }
        }

        $M.@Hairline {
          @Anchor = (Bottom: 12);
        }

        Label #ReadBody {
          FlexWeight: 1;
          Style: $M.@BodyStyle;
        }

        Label #RewardsLabel {
          Anchor: (Height: 16, Top: 10, Bottom: 8);
          Style: $M.@EyebrowGoldStyle;
          Text: "Rewards";
          Visible: false;
        }

        Group #RewardList {
          Anchor: (Height: 70, Bottom: 10);
          LayoutMode: Left;
        }

        $M.@ActionBar {
          @Anchor = (Height: 44);

          $C.@TextButton #ClaimButton {
            @Text = "Claim";
            @Anchor = (Width: 130, Right: 8);
          }

          $C.@SecondaryTextButton #ArchiveButton {
            @Text = "Archive";
            @Anchor = (Width: 120, Right: 8);
          }

          $C.@SecondaryTextButton #RestoreButton {
            @Text = "Restore";
            @Anchor = (Width: 120);
          }

          $M.@Spacer {}

          $C.@CancelTextButton #DeleteButton {
            @Text = "Delete";
            @Anchor = (Width: 120);
          }
        }
      }

      // ----- Compose pane -----
      Group #ComposePane {
        FlexWeight: 1;
        LayoutMode: Top;
        Visible: false;

        Label #ComposeTitle {
          Anchor: (Height: 28, Bottom: 10);
          Style: $M.@DisplaySmallStyle;
        }

        Label #ToLabel {
          Anchor: (Height: 16, Bottom: 6);
          Style: $M.@EyebrowStyle;
          Text: "To";
        }

        $C.@TextField #ToInput {
          @Anchor = (Bottom: 10);
          PlaceholderText: "Player name — or pick one from the list";
        }

        Label #SubjectLabel {
          Anchor: (Height: 16, Bottom: 6);
          Style: $M.@EyebrowStyle;
          Text: "Subject";
          Visible: false;
        }

        $C.@TextField #SubjectInput {
          @Anchor = (Bottom: 10);
          PlaceholderText: "Announcement title...";
          Visible: false;
        }

        Label {
          Anchor: (Height: 16, Bottom: 6);
          Style: $M.@EyebrowStyle;
          Text: "Message";
        }

        $C.@MultilineTextField #BodyInput {
          @Anchor = (Height: 150, Bottom: 10);
          PlaceholderText: "Write your message...";
        }

        Label #CommandLabel {
          Anchor: (Height: 16, Bottom: 6);
          Style: $M.@EyebrowStyle;
          Text: "Reward commands  ·  separate with ;  ·  {player} {uuid}";
          Visible: false;
        }

        $C.@TextField #CommandInput {
          @Anchor = (Bottom: 10);
          PlaceholderText: "give {player} 1 Diamond; xp add {player} 100";
          Visible: false;
        }

        Label #RewardHeader {
          Anchor: (Height: 16, Bottom: 6);
          Style: $M.@EyebrowGoldStyle;
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 8);

          $C.@DropdownBox #ItemDropdown {
            @Anchor = (Vertical: 6, Right: 8);
            FlexWeight: 1;
          }

          Label {
            Anchor: (Width: 30, Height: 44);
            Style: $M.@EyebrowStyle;
            Text: "Qty";
          }

          $C.@TextField #QtyInput {
            @Anchor = (Vertical: 3, Width: 56, Right: 8);
            Value: "1";
          }

          $C.@SecondaryTextButton #AddButton {
            @Text = "Add";
            @Anchor = (Width: 90, Right: 8);
          }

          $C.@TertiaryTextButton #ClearRewardsButton {
            @Text = "Clear";
            @Anchor = (Width: 90);
          }
        }

        Label #NoItemsLabel {
          Anchor: (Height: 26, Bottom: 6);
          Style: $M.@CaptionStyle;
          Visible: false;
        }

        Label #DraftLabel {
          Anchor: (Height: 16, Bottom: 6);
          Style: $M.@EyebrowStyle;
        }

        $M.@Well {
          FlexWeight: 1;

          Group #DraftList {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            Padding: (Right: 6);
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }

        $M.@ActionBar {
          @Anchor = (Height: 44, Top: 10);

          $C.@TertiaryTextButton #ComposeCancel {
            @Text = "Cancel";
            @Anchor = (Width: 120);
          }

          $M.@Spacer {}

          $C.@TextButton #ComposeSend {
            @Text = "Send";
            @Anchor = (Width: 150);
          }
        }
      }
    }
  }
}
