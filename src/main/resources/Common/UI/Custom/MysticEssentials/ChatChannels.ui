// Chat Channels — master/detail. The list is every channel the player can see;
// the panel is the selected channel with join/listen/leave. The channel the
// player is currently speaking in is called out at the top of the list.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 960, Height: 640);

  #Title {
    Group {
      $C.@Title {
        @Text = "Chat Channels";
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Master: channel list -----------------------------------------------
    Group {
      Anchor: (Width: 330);
      LayoutMode: Top;

      // Where the player is speaking right now.
      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Bottom: 10);
        Background: #E8A93B(0.10);
        Padding: (Left: 12, Right: 8);

        Group {
          Anchor: (Width: 3, Height: 22, Right: 10);
          Background: #E8A93B;
        }

        Label #CurrentChannelLabel {
          FlexWeight: 1;
          Style: (...$M.@SubheadingStyle, TextColor: #e8c97a);
        }

        $C.@SmallSecondaryTextButton #ViewMembersButton {
          @Text = "Members";
          @Anchor = (Width: 100, Vertical: 4);
          Visible: false;
        }
      }

      $M.@Section {
        @Text = "Channels";
        @Anchor = (Bottom: 10);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #ChannelEmpty {
          Anchor: (Height: 72);
          Style: $M.@EmptyStyle;
          Text: "No channels are available to you.";
          Visible: false;
        }

        Group #ChannelList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Detail: selected channel -------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 4);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      $M.@Panel {
        Anchor: (Bottom: 12);

        $M.@Section {
          @Text = "Selected Channel";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 8);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 32, Bottom: 8);

          Group #ChannelDetailSwatch {
            Anchor: (Width: 6, Height: 24, Top: 4, Right: 12);
            Background: #7a9cc6;
          }

          Label #ChannelName {
            FlexWeight: 1;
            Style: $M.@DisplayStyle;
          }
        }

        $M.@Hairline {
          @Anchor = (Bottom: 6);
        }

        $M.@KvRow {
          $M.@Key { @Text = "Type"; }
          Label #ChannelType { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Prefix"; }
          Label #ChannelPrefix { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Status"; }
          Label #ChannelStatus { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@Hairline {
          @Anchor = (Top: 6, Bottom: 12);
        }

        $M.@FieldLabel {
          @Text = "Password";
        }

        $C.@TextField #PasswordInput {
          @Anchor = (Bottom: 4);
          PlaceholderText: "Only needed for locked channels";
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44, Bottom: 18);

        $C.@TextButton #SwitchButton {
          @Text = "Speak Here";
          @Anchor = (Width: 170, Right: 8);
        }

        $C.@SecondaryTextButton #ListenButton {
          @Text = "Listen";
          @Anchor = (Width: 130);
        }

        $M.@Spacer {}

        $C.@CancelTextButton #LeaveButton {
          @Text = "Leave";
          @Anchor = (Width: 120);
        }
      }

      $M.@Section {
        @Text = "Temporary Channels";
        @Anchor = (Bottom: 6);
      }

      Label {
        Anchor: (Height: 18, Bottom: 8);
        Style: $M.@CaptionStyle;
        Text: "Spin up a private room for an event or a group; it closes itself when it goes quiet.";
      }

      $M.@ActionBar {
        @Anchor = (Height: 44);

        $C.@SecondaryTextButton #OpenTempButton {
          @Text = "Create Channel";
          @Anchor = (Width: 190, Right: 8);
        }

        $C.@TertiaryTextButton #ManageTempButton {
          @Text = "Manage Mine";
          @Anchor = (Width: 170);
          Visible: false;
        }
      }
    }
  }
}
