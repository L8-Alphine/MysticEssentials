// Online-player row in the Mail compose view. Appended per player:
//   cmd.append("#MailList", "MysticEssentials/MailPlayerRow.ui").
// Clicking the row fills the compose "To" field with that player's name.
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 44, Bottom: 4);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);

    $M.@IconWell {
      @Size = 32;
      @Anchor = (Right: 12);

      $M.@Bullet {
        Anchor: (Width: 8, Height: 8);
      }
    }

    Label #Name {
      FlexWeight: 1;
      Style: $M.@RowNameStyle;
    }

    Label #Pick {
      Anchor: (Width: 72);
      Style: (...$M.@PillStyle, TextColor: #e8c97a, HorizontalAlignment: End);
      Text: "Select";
    }
  }
}
