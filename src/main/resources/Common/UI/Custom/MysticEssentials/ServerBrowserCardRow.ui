// One row of up to three server cards in the Server Browser. Appended into
// #BrowserList; the server fills #Card0..#Card2 by index and hides the cards a
// short last row does not use, so every row keeps the same three columns.
//
// Per card: vanilla icon, name, region, a two-line description, a status line
// (live count, "You are here", "Coming soon", or why it is locked) and a
// Connect button whose label the server writes.
$C = "../Common.ui";
$M = "MysticTheme.ui";

@Card = Group {
  FlexWeight: 1;
  Background: #0b1422(0.38);
  LayoutMode: Top;
  Padding: (Full: 10);

  Group {
    Anchor: (Height: 36, Bottom: 6);
    LayoutMode: Left;

    $M.@IconWell {
      @Anchor = (Right: 10);

      AssetImage #Icon {
        Anchor: (Width: 22, Height: 22);
        AssetPath: "";
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      }
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #Name {
        Anchor: (Height: 20);
        Style: $M.@RowNameFitStyle;
      }

      Label #Region {
        Anchor: (Height: 16);
        Style: $M.@RowMetaFitStyle;
      }
    }
  }

  Label #Description {
    Anchor: (Height: 34, Bottom: 6);
    Style: (...$M.@HintStyle, FontSize: 12);
  }

  Group {
    Anchor: (Height: 30);
    LayoutMode: Left;

    Label #Status {
      FlexWeight: 1;
      Style: $M.@MetaFitStyle;
    }

    $C.@SmallSecondaryTextButton #Connect {
      @Text = "Connect";
      @Anchor = (Width: 112);
    }
  }
};

Group #Row {
  Anchor: (Height: 140, Bottom: 10);
  LayoutMode: Left;

  @Card #Card0 {}

  Group {
    Anchor: (Width: 10);
  }

  @Card #Card1 {}

  Group {
    Anchor: (Width: 10);
  }

  @Card #Card2 {}
}
