// Nickname — current nick up top, the new one below with its colour. Apply is
// primary; removing the nick is destructive and kept apart.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 560, Height: 440);

  #Title {
    Group {
      $C.@Title {
        @Text = "Nickname";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Panel {
      Anchor: (Bottom: 14);

      $M.@Section {
        @Text = "Current Nickname";
        @Style = $M.@EyebrowGoldStyle;
        @Anchor = (Bottom: 8);
      }

      Label #CurrentNick {
        Anchor: (Height: 30, Bottom: 12);
        Style: $M.@DisplayStyle;
      }

      $M.@Hairline {
        @Anchor = (Bottom: 12);
      }

      $M.@FieldLabel { @Text = "New Nickname"; }

      $C.@TextField #NickInput {
        @Anchor = (Bottom: 6);
        PlaceholderText: "Letters, digits and underscores";
      }

      Label {
        Anchor: (Height: 16, Bottom: 12);
        Style: $M.@CaptionStyle;
        Text: "Shown in chat and on the player list in place of your username.";
      }

      Group #ColorRow {
        LayoutMode: Left;
        Anchor: (Height: 32);

        Label {
          Anchor: (Width: 110);
          Style: $M.@KeyStyle;
          Text: "Colour";
        }

        ColorPickerDropdownBox #NickColor {
          Anchor: (Width: 50, Height: 32);
          Format: Rgb;
          Style: $C.@DefaultColorPickerDropdownBoxStyle;
          Color: #ffffff;
          DisplayTextField: true;
        }
      }
    }

    $M.@Spacer {}

    $M.@ActionBar {
      @Anchor = (Height: 44);

      $C.@TextButton #ApplyButton {
        @Text = "Apply";
        @Anchor = (Width: 160);
      }

      $M.@Spacer {}

      $C.@CancelTextButton #RemoveButton {
        @Text = "Remove Nickname";
        @Anchor = (Width: 200);
      }
    }
  }
}
