// Recently Shared Items — one row per remembered item link, each with the
// native item tooltip on hover and an Inspect button that opens ItemDetails.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 760, Height: 620);

  #Title {
    Group {
      $C.@Title {
        @Text = "Recently Shared Items";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Section {
      @Text = "Shared in Chat";
      @Anchor = (Bottom: 8);
    }

    $M.@Well {
      FlexWeight: 1;

      Label #RecentEmpty {
        Anchor: (Height: 72);
        Style: $M.@EmptyStyle;
        Text: "No items have been shared recently. Use [item] in chat to link the one you are holding.";
        Visible: false;
      }

      Group #RecentList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 12);

      $M.@Spacer {}

      $C.@TextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 150);
      }
    }
  }
}
