// Confirm Random Teleport — a focused confirmation with the terms laid out
// before the player commits. Begin is the primary action; Cancel is quiet.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 480, Height: 380);

  #Title {
    Group {
      $C.@Title {
        @Text = "Confirm Random Teleport";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Panel {
      Anchor: (Bottom: 14);

      $M.@Section {
        @Text = "Destination";
        @Style = $M.@EyebrowGoldStyle;
        @Anchor = (Bottom: 8);
      }

      Label #ProfileName {
        Anchor: (Height: 30, Bottom: 8);
        Style: $M.@DisplayStyle;
      }

      $M.@Hairline {
        @Anchor = (Bottom: 6);
      }

      Label #World {
        Anchor: (Height: 22);
        Style: $M.@ValueStyle;
      }

      Label #Range {
        Anchor: (Height: 22);
        Style: $M.@ValueStyle;
      }

      Label #Cost {
        Anchor: (Height: 22);
        Style: $M.@ValueStyle;
      }

      Label #Timing {
        Anchor: (Height: 22);
        Style: $M.@ValueStyle;
      }
    }

    $M.@Spacer {}

    $M.@ActionBar {
      @Anchor = (Height: 44);

      $C.@TertiaryTextButton #CancelButton {
        @Text = "Cancel";
        @Anchor = (Width: 130);
      }

      $M.@Spacer {}

      $C.@TextButton #ConfirmButton {
        @Text = "Begin Teleport";
        @Anchor = (Width: 190);
      }
    }
  }
}
