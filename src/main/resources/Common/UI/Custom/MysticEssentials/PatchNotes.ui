// Patch Notes — update list on the left, the selected note on the right as a
// readable article: title, meta, summary, category filters, then the body.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1180, Height: 720);

  #Title {
    Group {
      $C.@Title {
        @Text = "Patch Notes";
      }

      $M.@HeaderMeta #HeaderInfo {
        @Width = 260;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ===================== Left: update list =====================
    Group {
      Anchor: (Width: 340);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Updates";
        @Anchor = (Bottom: 10);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 10);

        $C.@TextField #SearchInput {
          @Anchor = (Vertical: 3, Right: 8);
          FlexWeight: 1;
          PlaceholderText: "Search patch notes...";
        }

        $C.@SecondaryTextButton #SearchButton {
          @Text = "Search";
          @Anchor = (Width: 100);
        }
      }

      $M.@Well {
        FlexWeight: 1;

        Label #ListEmpty {
          Anchor: (Height: 64);
          Style: $M.@EmptyStyle;
          Visible: false;
        }

        Group #NoteList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    $M.@ColumnDivider {}

    // ===================== Right: article =====================
    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #PatchTitle {
        Anchor: (Height: 32, Bottom: 2);
        Style: $M.@DisplayStyle;
      }

      Label #PatchMeta {
        Anchor: (Height: 16, Bottom: 8);
        Style: $M.@MetaStyle;
      }

      Label #PatchSummary {
        Anchor: (Height: 34, Bottom: 8);
        Style: $M.@BodyStyle;
        Visible: false;
      }

      // Category filter tabs (All + configured categories), appended per entry.
      Group #FilterBar {
        Anchor: (Height: 32, Bottom: 10);
        LayoutMode: Left;
      }

      $M.@Hairline {
        @Anchor = (Bottom: 10);
      }

      Label #ContentEmpty {
        Anchor: (Height: 30);
        Style: $M.@EmptyStyle;
        Visible: false;
      }

      Group #SectionContent {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 8);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      $M.@Hairline {
        @Anchor = (Top: 10, Bottom: 10);
      }

      $M.@ActionBar {
        @Anchor = (Height: 44);

        $C.@SecondaryTextButton #MarkAllButton {
          @Text = "Mark All As Read";
          @Anchor = (Width: 190);
        }

        $M.@Spacer {}

        $C.@TextButton #CloseButton {
          @Text = "Close";
          @Anchor = (Width: 130);
        }
      }
    }
  }
}
