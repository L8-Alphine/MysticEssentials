// Inventory Viewer — the contents of one snapshot. Restore is the primary
// action; Back is quiet.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 760, Height: 620);

  #Title {
    Group {
      $C.@Title {
        @Text = "Inventory Viewer";
      }

      $M.@HeaderMeta #ViewerSubtitle {
        @Width = 320;
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group {
      LayoutMode: Left;
      Anchor: (Height: 16, Bottom: 8);

      Label {
        Anchor: (Right: 10);
        Style: $M.@EyebrowStyle;
        Text: "Contents";
      }

      Label #ItemCount {
        FlexWeight: 1;
        Style: (...$M.@EyebrowStyle, TextColor: #96a9be);
      }
    }

    $M.@Well {
      FlexWeight: 1;

      Label #ItemsEmpty {
        Anchor: (Height: 64);
        Style: $M.@EmptyStyle;
        Text: "This snapshot has no items.";
        Visible: false;
      }

      Group #ItemList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 12);

      $C.@TertiaryTextButton #BackButton {
        @Text = "Back";
        @Anchor = (Width: 120);
      }

      $M.@Spacer {}

      $C.@TextButton #RestoreButton {
        @Text = "Restore This Snapshot";
        @Anchor = (Width: 240);
      }
    }
  }
}
