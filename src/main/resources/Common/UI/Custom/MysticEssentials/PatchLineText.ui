// Neutral body / bullet line in the Patch Notes viewer content.
//   cmd.append("#SectionContent", "MysticEssentials/PatchLineText.ui")
//   cmd.set("#SectionContent[i] #Line.TextSpans", ...)
$M = "MysticTheme.ui";

Group #Row {
  LayoutMode: Left;
  Anchor: (Height: 20);
  Padding: (Left: 12);

  Label #Line {
    FlexWeight: 1;
    Style: (FontSize: 14, TextColor: #dee2ef, VerticalAlignment: Center);
  }
}
