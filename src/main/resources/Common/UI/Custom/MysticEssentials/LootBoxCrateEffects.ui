// LootBox crate effect stack (crate editor step 6 sub-page). #EffectList takes
// LootBoxCrateEffectRow.ui rows; the selected effect's fields are on the right.
// #EffectIdDropdown is filled from the live particle or sound registry, filtered
// by #EffectSearchInput. #EffectFields hides while the stack is empty.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 900, Height: 620);

  #Title {
    Group {
      $C.@Title #HeaderTitle {
        @Text = "Effect Stack";
      }

      $M.@HeaderMeta #HeaderInfo {
        @Width = 360;
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #Notice {
      Anchor: (Bottom: 6);
      Style: $M.@BodyStyle;
      Visible: false;
    }

    Group {
      LayoutMode: Left;
      FlexWeight: 1;

      // ----- The stack ----------------------------------------------------------
      Group {
        LayoutMode: Top;
        Anchor: (Width: 340, Right: 14);

        $M.@Section {
          @Text = "Stack";
          @Anchor = (Bottom: 6);
        }

        $M.@Well {
          FlexWeight: 1;

          Group #EffectList {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            Padding: (Right: 6);
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Top: 8);

          $C.@SecondaryTextButton #AddParticleButton {
            @Text = "Add Particle";
            @Anchor = (Width: 165, Right: 6);
          }

          $C.@SecondaryTextButton #AddSoundButton {
            @Text = "Add Sound";
            @Anchor = (Width: 165);
          }
        }
      }

      // ----- The selected effect ------------------------------------------------
      $M.@Panel {
        @Padding = 14;

        FlexWeight: 1;

        Group #EffectFields {
          LayoutMode: Top;
          FlexWeight: 1;

          $M.@Section {
            @Text = "Selected effect";
            @Anchor = (Bottom: 8);
          }

          $M.@FieldLabel { @Text = "When it plays"; }
          $C.@DropdownBox #EffectPhaseDropdown {
            Anchor: (Width: 260, Height: 32, Bottom: 8);
          }

          $M.@FieldLabel { @Text = "Search the ids this server has loaded"; }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 38, Bottom: 6);

            $C.@TextField #EffectSearchInput {
              FlexWeight: 1;
              PlaceholderText: "sparks";
            }

            $C.@SecondaryTextButton #EffectSearchButton {
              @Text = "Search";
              @Anchor = (Width: 120, Left: 6);
            }
          }

          $C.@DropdownBox #EffectIdDropdown {
            Anchor: (Height: 32, Bottom: 8);
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 58, Bottom: 8);

            Group {
              LayoutMode: Top;
              Anchor: (Width: 140, Right: 10);

              $M.@FieldLabel { @Text = "Height"; }
              $C.@DropdownBox #EffectHeightDropdown {
                Anchor: (Width: 140, Height: 32);
              }
            }

            Group #EffectScaleGroup {
              LayoutMode: Top;
              Anchor: (Width: 140, Right: 10);

              $M.@FieldLabel { @Text = "Scale"; }
              $C.@DropdownBox #EffectScaleDropdown {
                Anchor: (Width: 140, Height: 32);
              }
            }

            Group #EffectIntervalGroup {
              LayoutMode: Top;
              Anchor: (Width: 140);

              $M.@FieldLabel { @Text = "Repeats every"; }
              $C.@DropdownBox #EffectIntervalDropdown {
                Anchor: (Width: 140, Height: 32);
              }
            }
          }

          Label #EffectHint {
            Anchor: (Height: 48);
            Style: $M.@HintStyle;
          }
        }

        Label #EffectEmpty {
          Anchor: (Height: 48);
          Style: $M.@HintStyle;
          Text: "The stack is empty. Add a particle or a sound; each one plays on top of the three effect slots on step 6.";
          Visible: false;
        }
      }
    }

    // ----- Footer -------------------------------------------------------------
    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 10);

      $C.@CancelTextButton #RemoveButton {
        @Text = "Remove";
        @Anchor = (Width: 130, Right: 6);
      }

      $C.@SecondaryTextButton #PreviewButton {
        @Text = "Preview Effects";
        @Anchor = (Width: 190);
      }

      $M.@Spacer {}

      $C.@TextButton #DoneButton {
        @Text = "Back to Crate";
        @Anchor = (Width: 180);
      }
    }
  }
}
