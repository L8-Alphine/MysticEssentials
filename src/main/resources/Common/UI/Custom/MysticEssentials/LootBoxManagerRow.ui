// One pool in the manager: name, draft and published state, and its lifecycle
// status. Selecting the row shows its actions under the list; #Selected marks it.
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 56, Bottom: 4);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  $M.@RowSelection #Selected {
    @Height = 56;
  }

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 12, Right: 12, Top: 10, Bottom: 10);

    $M.@IconWell {
      @Anchor = (Right: 12);

      ItemSlot #Icon {
        Anchor: (Width: 32, Height: 32);
        ShowQualityBackground: true;
        ShowQuantity: false;
      }
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;

      Label #Name {
        Anchor: (Height: 20, Bottom: 2);
        Style: $M.@RowNameStyle;
      }

      Label #Meta {
        Anchor: (Height: 14);
        Style: $M.@RowMetaStyle;
      }
    }

    Label #Status {
      Anchor: (Width: 200, Left: 8);
      Style: $M.@RowSideStyle;
    }
  }
}
