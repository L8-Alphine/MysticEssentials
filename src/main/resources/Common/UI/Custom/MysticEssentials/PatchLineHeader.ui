// Section header line in the Patch Notes viewer content.
//   cmd.append("#SectionContent", "MysticEssentials/PatchLineHeader.ui")
//   cmd.set("#SectionContent[i] #Line.TextSpans", ...)
$M = "MysticTheme.ui";

Group #Row {
  LayoutMode: Left;
  Anchor: (Height: 24, Top: 10, Bottom: 4);

  Group {
    Anchor: (Width: 3, Height: 14, Top: 5, Right: 9);
    Background: #7a9cc6;
  }

  Label #Line {
    FlexWeight: 1;
    Style: (...$M.@EyebrowStyle, FontSize: 12, TextColor: #96b8e0);
  }
}
