// Section header line in the Patch Notes viewer content.
//   cmd.append("#SectionContent", "MysticEssentials/PatchLineHeader.ui")
//   cmd.set("#SectionContent[i] #Line.TextSpans", ...)
$M = "MysticTheme.ui";

Group #Row {
  LayoutMode: Left;
  Anchor: (Height: 24, Top: 10, Bottom: 4);

  // The category's icon when it has one, else the plain blue rule.
  Group #Bar {
    Anchor: (Width: 3, Height: 14, Top: 5, Right: 9);
    Background: #67a5da;
  }

  AssetImage #Icon {
    Anchor: (Width: 20, Height: 20, Top: 2, Right: 8);
    AssetPath: "";
    FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
    Visible: false;
  }

  Label #Line {
    FlexWeight: 1;
    Style: (...$M.@EyebrowStyle, FontSize: 12, TextColor: #8fc2ec);
  }
}
