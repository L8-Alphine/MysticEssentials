// One result in the LootBox item picker. Appended per item:
//   cmd.append("#ResultList", "MysticEssentials/LootBoxItemPickerRow.ui")
// then #Icon.ItemId and the #Name / #Meta / #Status TextSpans are set and the
// row is bound. The root is an ItemSlotButton, like the game's barter cards: the
// whole row chooses the item, and hovering it shows the item's native tooltip.
// #Selected marks the item that is currently chosen.
$C = "../Common.ui";
$M = "MysticTheme.ui";

ItemSlotButton #Row {
  Anchor: (Height: 48, Bottom: 4);
  LayoutMode: Full;
  Style: (
    Default: (Background: #0a0f16(0.38)),
    Hovered: (Background: #7a9cc6(0.16)),
    Pressed: (Background: #7a9cc6(0.26)),
    Sounds: $C.@ButtonSounds
  );

  $M.@RowSelection #Selected {
    @Height = 48;
  }

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 12, Right: 12, Top: 6, Bottom: 6);

    $M.@IconWell {
      @Anchor = (Right: 12);

      ItemSlot #Icon {
        Anchor: (Width: 32, Height: 32);
        ShowQualityBackground: true;
        ShowQuantity: false;
      }
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;

      Label #Name {
        Anchor: (Height: 20, Bottom: 2);
        Style: $M.@RowNameFitStyle;
      }

      Label #Meta {
        Anchor: (Height: 14);
        Style: $M.@RowMetaFitStyle;
      }
    }

    Label #Status {
      Anchor: (Width: 120, Left: 8);
      Style: $M.@RowSideGoldStyle;
    }
  }
}
