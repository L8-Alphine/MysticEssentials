// Text content row for tutorial pages. Appended per content item:
//   cmd.append("#ContentList", "MysticEssentials/TutorialTextRow.ui")
// and populated by index: cmd.set("#ContentList[i] #Text.TextSpans", ...).
$M = "MysticTheme.ui";

Group #Row {
  LayoutMode: Left;
  Anchor: (Bottom: 10);

  $M.@Bullet {
    Anchor: (Width: 8, Height: 8, Top: 6, Right: 10);
  }

  Label #Text {
    FlexWeight: 1;
    Anchor: (Height: 40);
    Style: (...$M.@BodyStyle, VerticalAlignment: Start);
  }
}
