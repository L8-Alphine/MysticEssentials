// Inventory Snapshots — every recorded snapshot for a player, newest first.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 780, Height: 620);

  #Title {
    Group {
      $C.@Title {
        @Text = "Inventory Snapshots";
      }

      $M.@HeaderMeta #TargetName {
        @Width = 260;
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Section {
      @Text = "Snapshots";
      @Anchor = (Bottom: 8);
    }

    $M.@Well {
      FlexWeight: 1;

      Label #SnapshotsEmpty {
        Anchor: (Height: 72);
        Style: $M.@EmptyStyle;
        Text: "No snapshots recorded for this player yet.";
        Visible: false;
      }

      Group #SnapshotList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 12);

      $M.@Spacer {}

      $C.@SecondaryTextButton #SnapshotNowButton {
        @Text = "Take Snapshot Now";
        @Anchor = (Width: 220);
      }
    }
  }
}
