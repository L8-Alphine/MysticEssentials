// Button row for tutorial pages. Appended per button:
//   cmd.append("#ButtonList", "MysticEssentials/TutorialButtonRow.ui")
// label set by index, click bound on the row root (Button):
//   cmd.set("#ButtonList[i] #ButtonLabel.TextSpans", ...)
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 44, Bottom: 6);
  Padding: (Left: 14, Right: 14);
  Style: $M.@InlineButtonStyle;
  LayoutMode: Full;

  Label #ButtonLabel {
    Anchor: (Full: 0);
    Style: (...$M.@TabLabelStyle, FontSize: 14);
  }
}
