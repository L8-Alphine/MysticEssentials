// Per-player notification settings, reached from the Notification Center.
//
// Each toggle carries its own state in its label. Critical alerts get a plain
// informational line rather than a disabled-looking toggle, because a control
// that cannot be operated is worse than an honest sentence explaining why.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 560, Height: 660);

  #Title {
    Group {
      $C.@Title #HeaderTitle {
        @Text = "Notification Settings";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #PageSubtitle {
      Anchor: (Height: 30, Bottom: 10);
      Style: $M.@BodyMutedStyle;
    }

    $M.@Section {
      @Text = "Where notifications appear";
      @Anchor = (Bottom: 8);
    }

    $M.@SettingRow #ChatToggle { @Text = "Chat"; @Anchor = (Bottom: 3); }
    $M.@SettingRow #TitlesToggle { @Text = "Titles"; @Anchor = (Bottom: 3); }
    $M.@SettingRow #ActionBarToggle { @Text = "Action Bar"; @Anchor = (Bottom: 3); }
    $M.@SettingRow #ToastToggle { @Text = "Toasts"; @Anchor = (Bottom: 3); }
    $M.@SettingRow #SoundToggle { @Text = "Sounds"; @Anchor = (Bottom: 3); }
    $M.@SettingRow #BannerToggle { @Text = "Banners"; @Anchor = (Bottom: 14); }

    $M.@Section {
      @Text = "Quiet";
      @Anchor = (Bottom: 8);
    }

    $M.@SettingRow #DndToggle { @Text = "Do Not Disturb"; @Anchor = (Bottom: 8); }

    Label #CriticalNote {
      Anchor: (Height: 30, Bottom: 6);
      Style: $M.@CaptionWarnStyle;
    }

    $M.@Spacer {}

    $M.@ActionBar {
      @Anchor = (Height: 44);

      $C.@TertiaryTextButton #ResetButton {
        @Text = "Reset Defaults";
        @Anchor = (Width: 170, Right: 8);
      }

      $M.@Spacer {}

      $C.@SecondaryTextButton #BackButton {
        @Text = "Back";
        @Anchor = (Width: 120, Right: 8);
      }

      $C.@TextButton #CloseButton {
        @Text = "Done";
        @Anchor = (Width: 130);
      }
    }
  }
}
