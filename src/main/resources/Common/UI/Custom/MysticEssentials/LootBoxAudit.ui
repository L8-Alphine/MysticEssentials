// LootBox Audit History (P2-H): the audit trail newest first, filtered by
// target, actor, action and time window. Read-only. Rows are
// LootBoxAuditRow.ui appended into #RecordList; selecting one shows its full
// detail in #RecordPanel. Export writes the filtered records to a file.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 960, Height: 720);

  #Title {
    Group {
      $C.@Title {
        @Text = "Audit History";
      }

      $M.@HeaderMeta #HeaderInfo {
        @Width = 440;
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Panel {
      @Padding = 12;

      Anchor: (Bottom: 8);

      Group {
        LayoutMode: Left;
        Anchor: (Height: 58);

        Group {
          LayoutMode: Top;
          FlexWeight: 1;

          $M.@FieldLabel { @Text = "Pool or target"; }
          $C.@TextField #TargetInput {
            PlaceholderText: "A pool id, opening id, key id or serial";
          }
        }

        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Left: 12);

          $M.@FieldLabel { @Text = "Actor or player"; }
          $C.@TextField #ActorInput {
            PlaceholderText: "A player name or UUID, a staff name, server or console";
          }
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Top: 8);

        $C.@DropdownBox #ActionFilter {
          Anchor: (Width: 300, Height: 32, Top: 6);
        }

        $C.@DropdownBox #WindowFilter {
          Anchor: (Width: 200, Height: 32, Left: 8, Top: 6);
        }

        $M.@Spacer {}

        $C.@TextButton #ApplyButton {
          @Text = "Apply Filter";
          @Anchor = (Width: 170, Left: 8);
        }
      }
    }

    Label #Notice {
      Anchor: (Height: 20, Bottom: 4);
      Style: $M.@BodyStyle;
      Visible: false;
    }

    $M.@Section {
      @Text = "Records, newest first";
      @Anchor = (Bottom: 6);
    }

    $M.@Well {
      FlexWeight: 1;

      Label #ListEmpty {
        Anchor: (Height: 64);
        Style: $M.@EmptyStyle;
        Text: "No records match. Widen the time window or clear a filter.";
        Visible: false;
      }

      Group #RecordList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    $M.@Panel #RecordPanel {
      @Padding = 10;

      Anchor: (Top: 8);
      Visible: false;

      Label #AuditFullHead {
        Anchor: (Height: 18);
        Style: $M.@SubheadingStyle;
      }

      Label #AuditFullWho {
        Anchor: (Height: 16, Top: 2);
        Style: $M.@MetaStyle;
      }

      Label #AuditFullDetail {
        Anchor: (Height: 34, Top: 4);
        Style: $M.@BodyStyle;
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 8);

      $C.@SecondaryTextButton #NewerButton {
        @Text = "Newer";
        @Anchor = (Width: 110);
      }

      $C.@SecondaryTextButton #OlderButton {
        @Text = "Older";
        @Anchor = (Width: 110, Left: 6);
      }

      Label #AuditPageInfo {
        FlexWeight: 1;
        Anchor: (Left: 12);
        Style: $M.@MetaStyle;
      }

      $C.@SecondaryTextButton #ExportJsonButton {
        @Text = "Export JSON";
        @Anchor = (Width: 150, Left: 6);
      }

      $C.@SecondaryTextButton #ExportCsvButton {
        @Text = "Export CSV";
        @Anchor = (Width: 150, Left: 6);
      }

      $C.@TextButton #BackButton {
        @Text = "Back";
        @Anchor = (Width: 120, Left: 12);
      }
    }
  }
}
