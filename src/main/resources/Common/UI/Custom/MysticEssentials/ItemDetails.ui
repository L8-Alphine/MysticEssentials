// Item Details — a structured, read-only view of a shared item.
//
// This file is only the SHELL: identity header, scrolling body, footer. Every
// section inside #MysticItemBody is generated at runtime with appendInline,
// since which sections exist depends entirely on what the item actually has.
// Sections are omitted, never rendered empty, and never filled with a
// placeholder.
//
// The ItemSlotButton around the icon gives the game's native tooltip on hover;
// "Original Tooltip" re-renders the page in tooltip mode for the full text.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container #MysticItemShell {
  Anchor: (Width: 820, Height: 700);

  #Title {
    Group {
      $C.@Title #HeaderTitle {
        @Text = "Item Details";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    // ----- Identity ---------------------------------------------------------
    Group #HeaderPanel {
      LayoutMode: Left;
      Anchor: (Height: 118, Bottom: 12);
      Background: $M.@PanelBackground;
      Padding: (Left: 0, Right: 16, Top: 14, Bottom: 14);

      // Rarity spine, recoloured by the server.
      Group #RarityAccent {
        Anchor: (Width: 4, Height: 90, Right: 16);
        Background: #7a9cc6;
      }

      $M.@IconWell {
        @Size = 90;
        @Anchor = (Right: 18);

        ItemSlotButton #IconButton {
          Anchor: (Width: 80, Height: 80);

          ItemSlot #Icon {
            Anchor: (Full: 0);
            ShowQualityBackground: true;
            ShowQuantity: true;
          }
        }
      }

      Group {
        LayoutMode: Top;
        FlexWeight: 1;

        $M.@Spacer {}

        Label #ItemName {
          Anchor: (Height: 30, Bottom: 4);
          Style: $M.@DisplayStyle;
        }

        Label #ItemSubtitle {
          Anchor: (Height: 18, Bottom: 4);
          Style: $M.@MetaStyle;
        }

        Label #ItemId {
          Anchor: (Height: 14);
          Style: $M.@CaptionStyle;
        }

        $M.@Spacer {}
      }

      // Quality badge. Shows the item's quality name verbatim. Hidden entirely
      // when the item has no quality; never replaced with a placeholder.
      Group #QualityBadge {
        LayoutMode: CenterMiddle;
        Anchor: (Width: 116, Height: 26, Left: 10, Top: 4);
        Background: #7a9cc6(0.22);

        Label #QualityBadgeLabel {
          Anchor: (Full: 4);
          Style: $M.@PillStyle;
        }
      }
    }

    // ----- Generated sections -----------------------------------------------
    Group #MysticItemBody {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 8, Bottom: 8);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    Label #ShareInfo {
      Anchor: (Height: 20, Bottom: 10);
      Style: $M.@CaptionStyle;
    }

    $M.@ActionBar {
      @Anchor = (Height: 44);

      $C.@TertiaryTextButton #ReportButton {
        @Text = "Report";
        @Anchor = (Width: 110, Right: 8);
      }

      $C.@SecondaryTextButton #LayoutButton {
        @Text = "Compact";
        @Anchor = (Width: 130, Right: 8);
      }

      $C.@SecondaryTextButton #TooltipButton {
        @Text = "Original Tooltip";
        @Anchor = (Width: 190);
      }

      $M.@Spacer {}

      $C.@TextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 140);
      }
    }
  }
}
