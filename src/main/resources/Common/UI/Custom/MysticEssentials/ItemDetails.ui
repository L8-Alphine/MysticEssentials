$C = "../Common.ui";

// Item Details v2 — a structured, sectioned, read-only view of a shared item.
//
// This file is only the SHELL: header, scrolling body container, footer. Every
// section inside #MysticItemBody is generated at runtime with appendInline, since
// which
// sections exist depends entirely on what the item actually has. An item with no
// resonance data has no Resonance section at all — sections are omitted, never
// rendered empty, and never filled with a placeholder.
//
// Custom-UI ItemSlots do not receive the native hover tooltip, so the original
// tooltip is reachable through the explicit "Original Tooltip" button, which
// re-renders this same page in tooltip mode.

$C.@PageOverlay {}

$C.@Container #MysticItemShell {
  Anchor: (Width: 820, Height: 700);

  #Title {
    Group {
      $C.@Title #HeaderTitle {
        @Text = "Item Details";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    // ----- Identity panel -----------------------------------------------------
    Group #HeaderPanel {
      LayoutMode: Left;
      Anchor: (Height: 122, Bottom: 10);
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Full: 14);

      Group #RarityAccent {
        Anchor: (Width: 6, Height: 88, Right: 14);
        Background: #7a9cc6;
      }

      ItemSlotButton #IconButton {
        Anchor: (Width: 78, Height: 78, Right: 18);

        ItemSlot #Icon {
          Anchor: (Full: 0);
          ShowQualityBackground: true;
          ShowQuantity: true;
        }
      }

      Group {
        LayoutMode: Top;
        FlexWeight: 1;

        Label #ItemName {
          Anchor: (Height: 30, Bottom: 4);
          Style: (FontSize: 23, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center);
        }

        Label #ItemSubtitle {
          Anchor: (Height: 20, Bottom: 3);
          Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center);
        }

        Label #ItemId {
          Anchor: (Height: 16);
          Style: (FontSize: 12, TextColor: #6f7f93, VerticalAlignment: Center);
        }
      }

      // Quality badge. Shows the item's quality name verbatim — a quality
      // literally named "Null" reads "NULL" here. Hidden entirely when the item
      // has no quality; never replaced with "Unknown" or "Error".
      Group #QualityBadge {
        LayoutMode: CenterMiddle;
        Anchor: (Width: 116, Height: 34, Left: 10);
        Background: #7a9cc6(0.22);

        Label #QualityBadgeLabel {
          Anchor: (Full: 4);
          Style: (FontSize: 13, RenderBold: true, TextColor: #ffffff, HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }

    // ----- Generated sections -------------------------------------------------
    Group #MysticItemBody {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 10, Bottom: 8);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    Label #ShareInfo {
      Anchor: (Height: 22, Bottom: 8);
      Style: (FontSize: 12, TextColor: #7f8ea3, Wrap: true);
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 44);

      $C.@SecondaryTextButton #ReportButton {
        @Text = "Report";
        @Anchor = (Width: 120, Right: 8);
      }

      $C.@SecondaryTextButton #LayoutButton {
        @Text = "Compact";
        @Anchor = (Width: 130, Right: 8);
      }

      $C.@SecondaryTextButton #TooltipButton {
        @Text = "Original Tooltip";
        @Anchor = (Width: 190, Right: 8);
      }

      $C.@TextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 150);
      }
    }
  }
}
