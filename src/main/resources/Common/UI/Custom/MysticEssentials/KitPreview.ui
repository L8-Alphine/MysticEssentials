// Kit Preview — the contents of one kit, with Claim kept within reach.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 820, Height: 620);

  #Title {
    Group {
      $C.@Title {
        @Text = "Kit Preview";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Panel {
      @Padding = 14;
      Anchor: (Bottom: 12);

      Label #PreviewTitle {
        Anchor: (Height: 30, Bottom: 4);
        Style: $M.@DisplayStyle;
      }

      Label #PreviewDescription {
        Anchor: (Height: 40);
        Style: $M.@BodyMutedStyle;
      }
    }

    $M.@Section {
      @Text = "Contents";
      @Anchor = (Bottom: 8);
    }

    $M.@Well {
      FlexWeight: 1;

      Label #PreviewEmpty {
        Anchor: (Height: 64);
        Style: $M.@EmptyStyle;
        Text: "This kit has no items.";
        Visible: false;
      }

      Group #PreviewList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 12);

      $C.@SecondaryTextButton #BackButton {
        @Text = "Back";
        @Anchor = (Width: 140);
      }

      $M.@Spacer {}

      $C.@TextButton #ClaimButton {
        @Text = "Claim";
        @Anchor = (Width: 170);
      }
    }
  }
}
