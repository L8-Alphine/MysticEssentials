// Warp Admin — create or edit one server warp. Saving at the admin's position
// is the primary action; deleting the warp is isolated at the end.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 640, Height: 640);

  #Title {
    Group {
      $C.@Title {
        @Text = "Warp Admin";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Panel {
      Anchor: (Bottom: 14);

      $M.@Section {
        @Text = "Warp";
        @Style = $M.@EyebrowGoldStyle;
        @Anchor = (Bottom: 8);
      }

      Label #AdminHeading {
        Anchor: (Height: 30, Bottom: 12);
        Style: $M.@DisplayStyle;
      }

      $M.@Hairline {
        @Anchor = (Bottom: 12);
      }

      $M.@FieldLabel { @Text = "Name"; }
      $C.@TextField #AdminName {
        @Anchor = (Bottom: 12);
        PlaceholderText: "Warp name";
      }

      $M.@FieldLabel { @Text = "Description"; }
      $C.@TextField #AdminDescription {
        @Anchor = (Bottom: 12);
        PlaceholderText: "What players will see in the list";
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 16, Bottom: 6);

        Label {
          Anchor: (Width: 148);
          Style: $M.@EyebrowStyle;
          Text: "Cost";
        }

        Label {
          FlexWeight: 1;
          Style: $M.@EyebrowStyle;
          Text: "Permission  ·  empty = public";
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 12);

        $C.@TextField #AdminCost {
          @Anchor = (Width: 140, Right: 8);
          PlaceholderText: "0";
        }

        $C.@TextField #AdminPermission {
          FlexWeight: 1;
          PlaceholderText: "e.g. mysticessentials.warp.vip";
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 32);

        Label {
          Anchor: (Width: 110);
          Style: $M.@KeyStyle;
          Text: "Visibility";
        }

        $C.@DropdownBox #AdminVisibility {
          Anchor: (Width: 240, Height: 32);
        }
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Bottom: 10);

      $C.@TextButton #SaveHereButton {
        @Text = "Save Warp Here";
        @Anchor = (Width: 200, Right: 8);
      }

      $C.@SecondaryTextButton #SaveDetailsButton {
        @Text = "Save Details";
        @Anchor = (Width: 160);
      }

      $M.@Spacer {}

      $C.@CancelTextButton #DeleteWarpButton {
        @Text = "Delete";
        @Anchor = (Width: 120);
      }
    }

    $M.@Spacer {}

    $M.@ActionBar {
      @Anchor = (Height: 44);

      $C.@TertiaryTextButton #BackToWarpsButton {
        @Text = "Back to Warps";
        @Anchor = (Width: 180);
      }
    }
  }
}
