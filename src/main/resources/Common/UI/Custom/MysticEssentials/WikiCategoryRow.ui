// Category item in the wiki browser's left rail. Categories nest
// ("Mods/Endgame & QoL"): the indents show a row's depth and #CategoryArrow
// whether it has sub-categories, "+" closed and "–" open.
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 36, Bottom: 2);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  $M.@RowSelection #CategorySelected {
    @Height = 36;
  }

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 10, Right: 10);

    Group #Indent1 {
      Anchor: (Width: 14);
      Visible: false;
    }

    Group #Indent2 {
      Anchor: (Width: 14);
      Visible: false;
    }

    Group #Indent3 {
      Anchor: (Width: 14);
      Visible: false;
    }

    Label #CategoryArrow {
      Anchor: (Width: 16);
      Style: (...$M.@RowSideGoldStyle, FontSize: 14, RenderBold: true, HorizontalAlignment: Start);
    }

    Label #CategoryName {
      FlexWeight: 1;
      Style: $M.@SubheadingFitStyle;
    }

    Label #CategoryCount {
      Anchor: (Width: 40);
      Style: $M.@RowSideStyle;
    }
  }
}
