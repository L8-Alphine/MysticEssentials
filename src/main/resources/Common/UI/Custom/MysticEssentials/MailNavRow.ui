// Sidebar navigation entry for the Mail UI. Appended per folder:
//   cmd.append("#NavTop", "MysticEssentials/MailNavRow.ui")
// then populated by index: cmd.set("#NavTop[i] #Label.TextSpans", ...),
// active state via cmd.set("#NavTop[i] #Accent.Visible", true), and the
// folder's vanilla icon via cmd.set("#NavTop[i] #Icon.AssetPath", ...).
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 34, Bottom: 3);
  Style: $M.@TabStyle;
  LayoutMode: Full;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 0, Right: 10);

    Group #Accent {
      Anchor: (Width: 3, Height: 34, Right: 9);
      Background: #d9b572;
      Visible: false;
    }

    // Common-rooted vanilla icon, set at runtime. Hidden until one is set so a
    // folder without an icon keeps its label aligned with the others.
    Group {
      Anchor: (Width: 20, Right: 8);
      LayoutMode: CenterMiddle;

      AssetImage #Icon {
        Anchor: (Width: 20, Height: 20);
        AssetPath: "";
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
        Visible: false;
      }
    }

    Label #Label {
      FlexWeight: 1;
      Style: (...$M.@TabLabelStyle, HorizontalAlignment: Start);
    }
  }
}
