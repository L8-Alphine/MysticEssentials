// Row template for the vault list dashboard. Appended per vault by the server:
//   cmd.append("#VaultList", "MysticEssentials/VaultCardRow.ui")
// and populated by index: cmd.set("#VaultList[i] #Name.TextSpans", ...).
// The row opens the vault; #EditButton opens the editor. #Swatch carries the
// vault's colour and #Icon its chosen item.
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 64, Bottom: 4);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 0, Right: 10, Top: 8, Bottom: 8);

    Group #Swatch {
      Anchor: (Width: 3, Height: 48, Right: 11);
      Background: #7a9cc6;
    }

    $M.@IconWell {
      @Size = 48;
      @Anchor = (Right: 12);

      ItemSlot #Icon {
        Anchor: (Width: 44, Height: 44);
        ShowQualityBackground: true;
        ShowQuantity: false;
      }
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 22, Bottom: 2);

        Label #Name {
          FlexWeight: 1;
          Style: (...$M.@RowNameStyle, FontSize: 16);
        }

        Label #Number {
          Anchor: (Width: 60);
          Style: (...$M.@RowSideStyle, FontSize: 13);
        }
      }

      Label #Meta {
        Anchor: (Height: 14);
        Style: $M.@RowMetaStyle;
      }
    }

    Label #Status {
      Anchor: (Width: 110, Left: 8);
      Style: (...$M.@RowSideStyle, Wrap: true);
    }

    Button #EditButton {
      Anchor: (Width: 76, Height: 32, Left: 10, Vertical: 8);
      Style: $M.@InlineButtonStyle;

      Label {
        Anchor: (Full: 0);
        Style: (...$M.@TabLabelStyle, FontSize: 12);
        Text: "Edit";
      }
    }
  }
}
