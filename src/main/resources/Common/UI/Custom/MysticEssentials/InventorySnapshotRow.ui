// Row template for the snapshot list in the Inventory Restore UI.
// Appended per snapshot: cmd.append("#SnapshotList", "MysticEssentials/InventorySnapshotRow.ui").
$C = "../Common.ui";
$M = "MysticTheme.ui";

Group #Row {
  Anchor: (Height: 52, Bottom: 4);
  LayoutMode: Left;
  Padding: (Left: 12, Right: 10, Top: 10, Bottom: 10);
  Background: #0a0f16(0.38);

  Label #Cause {
    Anchor: (Width: 110);
    Style: (...$M.@PillStyle, FontSize: 11, TextColor: #e8c97a, HorizontalAlignment: Start);
  }

  Label #Time {
    FlexWeight: 1;
    Style: (...$M.@RowNameStyle, FontSize: 14);
  }

  Label #Items {
    Anchor: (Width: 84, Right: 10);
    Style: $M.@RowSideStyle;
  }

  $C.@SmallSecondaryTextButton #ViewButton {
    @Text = "View";
    @Anchor = (Width: 84, Right: 6);
  }

  $C.@SmallTertiaryTextButton #RestoreButton {
    @Text = "Restore";
    @Anchor = (Width: 100);
  }
}
