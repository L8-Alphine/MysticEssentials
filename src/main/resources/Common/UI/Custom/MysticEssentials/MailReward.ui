// Reward slot template for the mail reading pane.
// Appended per attachment: cmd.append("#RewardList", "MysticEssentials/MailReward.ui")
// then cmd.set("#RewardList[i] #Slot.ItemId", ...) and "#RewardList[i] #Qty.TextSpans".
$M = "MysticTheme.ui";

Group #Cell {
  Anchor: (Width: 56, Height: 70, Right: 8);
  LayoutMode: Top;

  $M.@IconWell {
    @Size = 56;

    ItemSlot #Slot {
      Anchor: (Width: 50, Height: 50);
      ShowQualityBackground: true;
      ShowQuantity: false;
    }
  }

  Label #Qty {
    Anchor: (Height: 14);
    Style: (...$M.@CaptionStyle, TextColor: #dee2ef, HorizontalAlignment: Center);
  }
}
