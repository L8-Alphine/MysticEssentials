// Row template for the online-player list in the Teleport Requests UI.
// Appended per player: cmd.append("#PlayerList", "MysticEssentials/TpaPlayerRow.ui").
$C = "../Common.ui";
$M = "MysticTheme.ui";

Group #Row {
  Anchor: (Height: 48, Bottom: 4);
  LayoutMode: Left;
  Padding: (Left: 12, Right: 10, Top: 8, Bottom: 8);
  Background: #0a0f16(0.38);

  $M.@IconWell {
    @Size = 32;
    @Anchor = (Right: 12);

    $M.@Bullet {
      Anchor: (Width: 8, Height: 8);
    }
  }

  Label #Name {
    FlexWeight: 1;
    Style: $M.@RowNameStyle;
  }

  $C.@SmallSecondaryTextButton #TpaButton {
    @Text = "Go To";
    @Anchor = (Width: 84, Right: 6);
  }

  $C.@SmallTertiaryTextButton #HereButton {
    @Text = "Bring";
    @Anchor = (Width: 84, Right: 6);
  }

  $C.@SmallTertiaryTextButton #FavButton {
    @Text = "Star";
    @Anchor = (Width: 66);
  }
}
