// Member Actions — one member's details plus moderation. Buttons are shown only
// when the server has authorised them for the viewer; the client is never
// trusted to decide what a moderator may do. Destructive actions are grouped
// last, under their own heading, so a slip of the mouse near "Make Speaker"
// cannot land on "Ban".
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 480, Height: 640);

  #Title {
    Group {
      $C.@Title {
        @Text = "Member Actions";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Panel {
      @Padding = 14;
      Anchor: (Bottom: 12);

      Label #MName {
        Anchor: (Height: 30, Bottom: 2);
        Style: $M.@DisplayStyle;
      }

      Label #MTags {
        Anchor: (Height: 16, Bottom: 8);
        Style: $M.@MetaGoldStyle;
      }

      $M.@Hairline {
        @Anchor = (Bottom: 4);
      }

      $M.@KvRow {
        $M.@Key { @Text = "Participation"; @Width = 120; }
        Label #MParticipation { FlexWeight: 1; Style: $M.@ValueStyle; }
      }

      $M.@KvRow {
        $M.@Key { @Text = "Server Rank"; @Width = 120; }
        Label #MRank { FlexWeight: 1; Style: $M.@ValueStyle; }
      }

      $M.@KvRow {
        $M.@Key { @Text = "Joined"; @Width = 120; }
        Label #MJoined { FlexWeight: 1; Style: $M.@ValueStyle; }
      }

      $M.@KvRow {
        $M.@Key { @Text = "Moderation"; @Width = 120; }
        Label #MModeration { FlexWeight: 1; Style: $M.@ValueStyle; }
      }
    }

    // Mute inputs (shown when the viewer can moderate).
    Group #MuteInputs {
      LayoutMode: Left;
      Anchor: (Height: 38, Bottom: 10);

      $C.@TextField #MuteDuration {
        @Anchor = (Width: 110, Right: 8);
        PlaceholderText: "10m";
      }

      $C.@TextField #MuteReason {
        FlexWeight: 1;
        PlaceholderText: "Reason (optional)";
      }
    }

    Group #ActionButtons {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 6);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      $M.@Section {
        @Text = "Role";
        @Anchor = (Bottom: 8);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 8);

        $C.@SecondaryTextButton #SpeakerBtn { @Text = "Make Speaker"; @Anchor = (Right: 8); FlexWeight: 1; Visible: false; }
        $C.@SecondaryTextButton #ListenerBtn { @Text = "Make Listener"; FlexWeight: 1; Visible: false; }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 12);

        $C.@SecondaryTextButton #ModAddBtn { @Text = "Promote Moderator"; @Anchor = (Right: 8); FlexWeight: 1; Visible: false; }
        $C.@CancelTextButton #ModRemoveBtn { @Text = "Remove Moderator"; FlexWeight: 1; Visible: false; }
      }

      $M.@Section {
        @Text = "Voice";
        @Anchor = (Bottom: 8);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 12);

        $C.@TextButton #MuteBtn { @Text = "Channel Mute"; @Anchor = (Right: 8); FlexWeight: 1; Visible: false; }
        $C.@SecondaryTextButton #UnmuteBtn { @Text = "Remove Mute"; FlexWeight: 1; Visible: false; }
      }

      $M.@Section {
        @Text = "Membership";
        @Style = $M.@EyebrowDangerStyle;
        @Anchor = (Bottom: 8);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 8);

        $C.@CancelTextButton #RemoveBtn { @Text = "Remove From Channel"; @Anchor = (Right: 8); FlexWeight: 1; Visible: false; }
        $C.@CancelTextButton #BanBtn { @Text = "Ban"; FlexWeight: 1; Visible: false; }
        $C.@SecondaryTextButton #UnbanBtn { @Text = "Unban"; FlexWeight: 1; Visible: false; }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 8);

        $C.@TextButton #TransferBtn { @Text = "Transfer Ownership"; FlexWeight: 1; Visible: false; }
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 8);

      $C.@TertiaryTextButton #BackBtn {
        @Text = "Back to Members";
        FlexWeight: 1;
      }
    }
  }
}
