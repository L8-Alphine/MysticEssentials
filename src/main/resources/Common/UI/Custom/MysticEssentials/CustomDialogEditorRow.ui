Button #Row {
  Anchor: (Height: 38, Bottom: 5);
  LayoutMode: Left;
  Padding: (Horizontal: 10, Vertical: 6);
  Style: (
    Default: (Background: #000000(0.18)),
    Hovered: (Background: #7a9cc6(0.18)),
    Pressed: (Background: #7a9cc6(0.28))
  );

  Group #Selected {
    Anchor: (Width: 5, Right: 8);
    Background: #e8c97a;
  }

  Label #Label {
    FlexWeight: 1;
    Style: (FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center);
  }
}
