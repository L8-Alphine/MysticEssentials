// Row template for the page / button lists in the CustomDialogs Builder.
// The server marks the selected entry with cmd.set("... #Selected.Visible", true).
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 36, Bottom: 3);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  $M.@RowSelection #Selected {
    @Height = 36;
  }

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 12, Right: 10);

    Label #Label {
      FlexWeight: 1;
      Style: (...$M.@RowNameStyle, FontSize: 13, RenderBold: false);
    }
  }
}
