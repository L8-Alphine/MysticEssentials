// Row template for the update list in the Patch Notes UI. Appended per note:
//   cmd.append("#NoteList", "MysticEssentials/PatchNoteRow.ui")
// then populated by index: cmd.set("#NoteList[i] #Title.TextSpans", ...).
// The row root is a Button so the whole card selects the patch. #Accent marks
// the note being read; #Pinned shows for pinned notes; #Unread carries the dot.
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 58, Bottom: 4);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 0, Right: 12, Top: 9, Bottom: 9);

    Group #Accent {
      Anchor: (Width: 3, Height: 40, Right: 9);
      Background: #d9b572;
      Visible: false;
    }

    // The patch's icon (or item), set by the server.
    $M.@IconWell {
      @Size = 40;
      @Anchor = (Right: 10);

      AssetImage #RowIcon {
        Anchor: (Width: 30, Height: 30);
        AssetPath: "";
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
        Visible: false;
      }

      ItemSlot #RowItem {
        Anchor: (Width: 36, Height: 36);
        ShowQualityBackground: false;
        ShowQuantity: false;
        Visible: false;
      }
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 22, Bottom: 2);

        Label #Unread {
          Anchor: (Width: 14);
          Style: (...$M.@RowNameStyle, TextColor: #64c995);
        }

        Label #Title {
          FlexWeight: 1;
          Style: $M.@RowNameStyle;
        }
      }

      Label #Meta {
        Anchor: (Height: 14);
        Style: $M.@RowMetaStyle;
      }
    }

    Group #Pinned {
      Anchor: (Width: 64, Height: 18, Left: 6, Top: 11);
      Background: #67a5da(0.30);
      Padding: (Horizontal: 4);
      LayoutMode: CenterMiddle;
      Visible: false;

      Label {
        Anchor: (Full: 0);
        Style: $M.@PillStyle;
        Text: "Pinned";
      }
    }
  }
}
