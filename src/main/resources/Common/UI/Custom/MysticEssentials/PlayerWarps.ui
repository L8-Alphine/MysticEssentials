// Player Warps — browse every player's public warp. Master/detail with search.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1000, Height: 660);

  #Title {
    Group {
      $C.@Title {
        @Text = "Player Warps";
      }

      $C.@HeaderSearch {}
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Master: warp list --------------------------------------------------
    Group {
      Anchor: (Width: 340);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Community Warps";
        @Anchor = (Bottom: 10);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #PwarpEmpty {
          Anchor: (Height: 72);
          Style: $M.@EmptyStyle;
          Text: "No player warps yet. Be the first with /pwarp create <name>.";
          Visible: false;
        }

        Group #PwarpList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Detail: selected warp ----------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 4);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      $M.@Panel {
        Anchor: (Bottom: 12);

        $M.@Section {
          @Text = "Selected Warp";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 8);
        }

        Label #PwarpName {
          Anchor: (Height: 32, Bottom: 4);
          Style: $M.@DisplayStyle;
        }

        Label #PwarpDescription {
          Anchor: (Bottom: 10);
          Style: $M.@BodyMutedStyle;
        }

        $M.@Hairline {
          @Anchor = (Bottom: 6);
        }

        $M.@KvRow {
          $M.@Key { @Text = "Owner"; }
          Label #PwarpOwner { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Cost"; }
          Label #PwarpCost { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "World"; }
          Label #PwarpWorld { FlexWeight: 1; Style: $M.@ValueStyle; }
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44, Bottom: 12);

        $C.@TextButton #TeleportButton {
          @Text = "Teleport";
          @Anchor = (Width: 190, Right: 8);
        }

        $M.@Spacer {}

        $C.@SecondaryTextButton #MyWarpsButton {
          @Text = "My Warps";
          @Anchor = (Width: 160);
        }
      }

      Label #PwarpLimit {
        Anchor: (Height: 18);
        Style: $M.@CaptionStyle;
      }
    }
  }
}
