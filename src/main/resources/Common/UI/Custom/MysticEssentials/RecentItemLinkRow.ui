// One row in the Recently Shared Items list. Appended per entry:
//   cmd.append("#RecentList", "MysticEssentials/RecentItemLinkRow.ui")
// then set #Icon.ItemId, #Name.TextSpans, #Meta.TextSpans and bind #InspectButton.
$C = "../Common.ui";
$M = "MysticTheme.ui";

Group #Row {
  Anchor: (Height: 56, Bottom: 4);
  LayoutMode: Left;
  Padding: (Left: 12, Right: 12, Top: 10, Bottom: 10);
  Background: #0a0f16(0.38);

  // ItemSlotButton parent gives the native item tooltip on hover.
  ItemSlotButton #IconButton {
    Anchor: (Width: 36, Height: 36, Right: 12);

    ItemSlot #Icon {
      Anchor: (Full: 0);
      ShowQualityBackground: true;
      ShowQuantity: false;
    }
  }

  Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Label #Name {
      Anchor: (Height: 20, Bottom: 2);
      Style: $M.@RowNameStyle;
    }

    Label #Meta {
      Anchor: (Height: 14);
      Style: $M.@RowMetaStyle;
    }
  }

  $C.@SmallSecondaryTextButton #InspectButton {
    @Text = "Inspect";
    @Anchor = (Width: 110, Left: 8, Vertical: 2);
  }
}
