$C = "../Common.ui";

// Expanded channel member-management interface (design bible §6). Left column is
// channel information; right column is a searchable member list. Phase 1 shows
// authority tags, staff/rank and speaker/listener participation; management
// actions arrive in a later phase.

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1040, Height: 680);

  #Title {
    Group {
      $C.@Title {
        @Text = "Channel Members";
      }
    }
  }

  #Content {
    LayoutMode: Left;
    Group {
      Anchor: (Width: 320);
      LayoutMode: Top;

      Group {
        Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
        LayoutMode: Top;
        Padding: (Full: 16);

        Label {
          Anchor: (Height: 16, Bottom: 6);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, TextColor: #9fb0c4);
          Text: "CHANNEL INFORMATION";
        }

        Label #InfoName {
          Anchor: (Height: 26, Bottom: 4);
          Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
        }

        Label #InfoType {
          Anchor: (Height: 18, Bottom: 12);
          Style: (FontSize: 13, TextColor: #E8A93B, VerticalAlignment: Center);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 8);
          Label { Anchor: (Width: 90); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true); Text: "Owner"; }
          Label #InfoOwner { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 8);
          Label { Anchor: (Width: 90); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true); Text: "Access"; }
          Label #InfoAccess { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13); }
        }

        Group {
          LayoutMode: Left;
          Label { Anchor: (Width: 90); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true); Text: "Members"; }
          Label #InfoMembers { FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 13); }
        }
      }
    }
    Group {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Left: 12);

      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 8);

        $C.@TextField #SearchInput {
          @Anchor = (Right: 6);
          FlexWeight: 1;
          PlaceholderText: "Search members...";
        }

        $C.@SecondaryTextButton #SearchButton {
          @Text = "Search";
          @Anchor = (Width: 110);
        }
      }

      Label #MembersEmpty {
        Anchor: (Height: 40);
        Style: (FontSize: 14, TextColor: #9fb0c4, VerticalAlignment: Center);
        Text: "No members match.";
        Visible: false;
      }

      Group #MemberList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 10);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      $C.@PanelSeparatorFancy {
        @Anchor = (Top: 8, Bottom: 8);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 42);

        Label #FooterCounts {
          FlexWeight: 1;
          Style: (FontSize: 13, TextColor: #9fb0c4, VerticalAlignment: Center);
        }

        $C.@SecondaryTextButton #RefreshButton {
          @Text = "Refresh";
          @Anchor = (Width: 120, Right: 8);
        }

        $C.@CancelTextButton #CloseMembersButton {
          @Text = "Close";
          @Anchor = (Width: 120);
        }
      }
    }
  }
}
