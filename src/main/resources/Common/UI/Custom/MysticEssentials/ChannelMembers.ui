// Channel Members — the full member-management page. Left column is the channel
// card; right column is a searchable member list. Actions on a member open
// ChannelMemberActions; the server decides what the viewer may do.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1040, Height: 680);

  #Title {
    Group {
      $C.@Title {
        @Text = "Channel Members";
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Channel card -------------------------------------------------------
    Group {
      Anchor: (Width: 320);
      LayoutMode: Top;

      $M.@Panel {
        $M.@Section {
          @Text = "Channel";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 8);
        }

        Label #InfoName {
          Anchor: (Height: 30, Bottom: 2);
          Style: $M.@DisplayStyle;
        }

        Label #InfoType {
          Anchor: (Height: 16, Bottom: 10);
          Style: $M.@MetaGoldStyle;
        }

        $M.@Hairline {
          @Anchor = (Bottom: 6);
        }

        $M.@KvRow {
          $M.@Key { @Text = "Owner"; @Width = 90; }
          Label #InfoOwner { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Access"; @Width = 90; }
          Label #InfoAccess { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Members"; @Width = 90; }
          Label #InfoMembers { FlexWeight: 1; Style: $M.@ValueStyle; }
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Member list --------------------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 10);

        $C.@TextField #SearchInput {
          @Anchor = (Vertical: 3, Right: 8);
          FlexWeight: 1;
          PlaceholderText: "Search members...";
        }

        $C.@SecondaryTextButton #SearchButton {
          @Text = "Search";
          @Anchor = (Width: 110);
        }
      }

      $M.@Well {
        FlexWeight: 1;

        Label #MembersEmpty {
          Anchor: (Height: 64);
          Style: $M.@EmptyStyle;
          Text: "No members match that search.";
          Visible: false;
        }

        Group #MemberList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44, Top: 12);

        Label #FooterCounts {
          FlexWeight: 1;
          Style: $M.@MetaStyle;
        }

        $C.@SecondaryTextButton #RefreshButton {
          @Text = "Refresh";
          @Anchor = (Width: 120, Right: 8);
        }

        $C.@TertiaryTextButton #CloseMembersButton {
          @Text = "Close";
          @Anchor = (Width: 110);
        }
      }
    }
  }
}
