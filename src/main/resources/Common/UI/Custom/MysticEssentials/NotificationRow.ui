// One row in the Notification Center. Appended per entry:
//   cmd.append("#NotificationList", "MysticEssentials/NotificationRow.ui")
// then #Title / #Sub / #Meta are set and #OpenButton / #DismissButton are bound.
//
// #Accent is recoloured per category so the list scans by colour at a glance;
// unread rows say so in #Meta rather than relying on colour alone.
$C = "../Common.ui";
$M = "MysticTheme.ui";

Group #Row {
  Anchor: (Height: 68, Bottom: 4);
  LayoutMode: Left;
  Background: #0a0f16(0.38);
  Padding: (Left: 0, Right: 12, Top: 8, Bottom: 8);

  Group #Accent {
    Anchor: (Width: 3, Height: 52, Right: 13);
    Background: #7a9cc6;
  }

  Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Label #Title {
      Anchor: (Height: 20, Bottom: 2);
      Style: $M.@RowNameStyle;
    }

    Label #Sub {
      Anchor: (Height: 16, Bottom: 2);
      Style: (...$M.@RowMetaStyle, TextColor: #c9d6e5);
    }

    Label #Meta {
      Anchor: (Height: 12);
      Style: $M.@CaptionStyle;
    }
  }

  $C.@SmallSecondaryTextButton #OpenButton {
    @Text = "Open";
    @Anchor = (Width: 84, Left: 8, Right: 6, Vertical: 10);
  }

  $C.@SmallTertiaryTextButton #DismissButton {
    @Text = "Dismiss";
    @Anchor = (Width: 96, Vertical: 10);
  }
}
