// CustomDialogs Builder — an editor for NPC dialogs. Top strip picks or
// creates a dialog; the identity panel names it; below that, pages on the left
// and the selected page's text and response buttons on the right.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 900, Height: 760);

  #Title {
    Group {
      $C.@Title {
        @Text = "CustomDialogs Builder";
      }
    }
  }

  #CloseButton { Visible: true; }

  #Content {
    LayoutMode: Top;

    // ---- Dialog picker ----------------------------------------------------
    Group {
      LayoutMode: Left;
      Anchor: (Height: 38, Bottom: 10);

      $C.@DropdownBox #DialogDropdown {
        @Anchor = (Top: 3, Right: 8);
        FlexWeight: 1;
      }

      $C.@TextField #NewDialogId {
        @Anchor = (Width: 200, Right: 8);
        PlaceholderText: "new_dialog_id";
      }

      $C.@SmallSecondaryTextButton #CreateDialogButton {
        @Text = "Create";
        @Anchor = (Width: 90, Right: 6, Top: 3);
      }

      $C.@SmallTertiaryTextButton #DeleteDialogButton {
        @Text = "Delete";
        @Anchor = (Width: 90, Top: 3);
      }
    }

    Group #DialogEditor {
      FlexWeight: 1;
      LayoutMode: Top;

      // ---- Identity -------------------------------------------------------
      $M.@Panel {
        @Padding = 12;
        Anchor: (Bottom: 10);

        $M.@Section {
          @Text = "Dialog";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 8);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 38);

          $C.@TextField #DialogTitle {
            @Anchor = (Right: 8);
            FlexWeight: 1;
            PlaceholderText: "Dialog title";
          }

          $C.@TextField #NpcName {
            @Anchor = (Right: 8);
            FlexWeight: 1;
            PlaceholderText: "NPC name";
          }

          $C.@DropdownBox #DialogWidth {
            Anchor: (Width: 150, Height: 32, Top: 3, Right: 8);
          }

          $C.@SmallSecondaryTextButton #AssignButton {
            @Text = "Assign NPC";
            @Anchor = (Width: 120, Top: 3);
          }
        }
      }

      // ---- Pages + page editor ---------------------------------------------
      Group {
        LayoutMode: Left;
        FlexWeight: 1;

        Group {
          Anchor: (Width: 250, Right: 10);
          LayoutMode: Top;

          Label #PageCount {
            Anchor: (Height: 16, Bottom: 8);
            Style: $M.@EyebrowStyle;
          }

          $M.@Well {
            FlexWeight: 1;

            Group #PageList {
              LayoutMode: TopScrolling;
              FlexWeight: 1;
              ScrollbarStyle: $C.@DefaultScrollbarStyle;
              Padding: (Right: 5);
            }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Top: 8);

            $C.@SmallSecondaryTextButton #AddPageButton {
              @Text = "+";
              @Anchor = (Width: 44, Right: 4);
            }

            $C.@SmallTertiaryTextButton #MovePageUpButton {
              @Text = "Up";
              @Anchor = (Width: 54, Right: 4);
            }

            $C.@SmallTertiaryTextButton #MovePageDownButton {
              @Text = "Down";
              @Anchor = (Width: 66, Right: 4);
            }

            $C.@SmallTertiaryTextButton #RemovePageButton {
              @Text = "X";
              @Anchor = (Width: 44);
            }
          }
        }

        Group #PageEditor {
          Background: $M.@PanelBackground;
          LayoutMode: Top;
          Padding: (Full: 12);
          FlexWeight: 1;

          Label #PageHeading {
            Anchor: (Height: 16, Bottom: 8);
            Style: $M.@EyebrowGoldStyle;
          }

          $C.@MultilineTextField #PageText {
            @Anchor = (Height: 110, Bottom: 8);
            Value: "";
          }

          $C.@TextField #ContinueLabel {
            @Anchor = (Bottom: 12);
            PlaceholderText: "Continue button label";
          }

          Group #ButtonPanel {
            LayoutMode: Left;
            FlexWeight: 1;

            Group {
              LayoutMode: Top;
              Anchor: (Width: 210, Right: 10);

              Label #ButtonCount {
                Anchor: (Height: 16, Bottom: 6);
                Style: $M.@EyebrowStyle;
              }

              $M.@Well {
                FlexWeight: 1;

                Group #ButtonList {
                  LayoutMode: TopScrolling;
                  FlexWeight: 1;
                  ScrollbarStyle: $C.@DefaultScrollbarStyle;
                  Padding: (Right: 5);
                }
              }

              Group {
                LayoutMode: Left;
                Anchor: (Height: 32, Top: 6);

                $C.@SmallSecondaryTextButton #AddButtonButton {
                  @Text = "+";
                  @Anchor = (Width: 42, Right: 3);
                }

                $C.@SmallTertiaryTextButton #MoveButtonUpButton {
                  @Text = "Up";
                  @Anchor = (Width: 48, Right: 3);
                }

                $C.@SmallTertiaryTextButton #MoveButtonDownButton {
                  @Text = "Down";
                  @Anchor = (Width: 58, Right: 3);
                }

                $C.@SmallTertiaryTextButton #RemoveButtonButton {
                  @Text = "X";
                  @Anchor = (Width: 42);
                }
              }
            }

            Group #ButtonEditor {
              LayoutMode: Top;
              FlexWeight: 1;

              Label {
                Anchor: (Height: 16, Bottom: 6);
                Style: $M.@EyebrowStyle;
                Text: "Response button";
              }

              $C.@TextField #ButtonText {
                @Anchor = (Bottom: 8);
                PlaceholderText: "Button text";
              }

              $C.@MultilineTextField #ButtonActions {
                @Anchor = (Height: 100);
                Value: "";
              }

              Label {
                Anchor: (Height: 30, Top: 6);
                Style: $M.@CaptionStyle;
                Text: "Comma-separated dialog actions, run in order when the button is chosen.";
              }
            }
          }
        }
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 10);

      $M.@Spacer {}

      $C.@SecondaryTextButton #SaveCloseButton {
        @Text = "Save & Close";
        @Anchor = (Width: 160, Right: 8);
      }

      $C.@TextButton #SaveButton {
        @Text = "Save & Export";
        @Anchor = (Width: 170);
      }
    }
  }
}
