// Item-picker row in the Mail compose pane (inventory items, or the full item
// registry for announcements). Appended per candidate:
//   cmd.append("#PickerList", "MysticEssentials/MailPickerRow.ui")
// Clicking the row attaches the item (quantity taken from the qty field).
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 44, Bottom: 4);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 12, Right: 12, Top: 4, Bottom: 4);

    $M.@IconWell {
      @Anchor = (Right: 12);

      ItemSlot #Icon {
        Anchor: (Width: 32, Height: 32);
        ShowQualityBackground: true;
        ShowQuantity: false;
      }
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;

      Label #Name {
        Anchor: (Height: 20, Bottom: 2);
        Style: $M.@RowNameStyle;
      }

      Label #Meta {
        Anchor: (Height: 14);
        Style: $M.@RowMetaStyle;
      }
    }

    Label #Have {
      Anchor: (Width: 70, Left: 8);
      Style: $M.@RowSideStyle;
    }
  }
}
