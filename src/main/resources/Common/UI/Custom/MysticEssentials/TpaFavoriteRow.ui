// Row template for the favourites list in the Teleport Requests UI.
// Appended per favourite: cmd.append("#FavoriteList", "MysticEssentials/TpaFavoriteRow.ui").
// For offline favourites the Go To / Bring buttons are hidden and #Status shows "offline".
$C = "../Common.ui";
$M = "MysticTheme.ui";

Group #Row {
  Anchor: (Height: 48, Bottom: 4);
  LayoutMode: Left;
  Padding: (Left: 12, Right: 10, Top: 8, Bottom: 8);
  Background: #E8A93B(0.07);

  $M.@IconWell {
    @Size = 32;
    @Anchor = (Right: 12);

    Group {
      Anchor: (Width: 12, Height: 12);
      Background: #E8A93B;
    }
  }

  Label #Name {
    FlexWeight: 1;
    Style: (...$M.@RowNameStyle, TextColor: #e8c97a);
  }

  Label #Status {
    Anchor: (Width: 70, Right: 8);
    Style: $M.@RowSideStyle;
  }

  $C.@SmallSecondaryTextButton #TpaButton {
    @Text = "Go To";
    @Anchor = (Width: 84, Right: 6);
  }

  $C.@SmallTertiaryTextButton #HereButton {
    @Text = "Bring";
    @Anchor = (Width: 84, Right: 6);
  }

  $C.@SmallTertiaryTextButton #UnfavButton {
    @Text = "Unstar";
    @Anchor = (Width: 66);
  }
}
