// Chosen-attachment row in the Mail compose pane.
// Appended per pending pick: cmd.append("#DraftList", "MysticEssentials/MailDraftRow.ui")
// then cmd.set("#DraftList[i] #Name.TextSpans", ...) etc. #Remove drops the pick.
$C = "../Common.ui";
$M = "MysticTheme.ui";

Group #Row {
  Anchor: (Height: 40, Bottom: 4);
  LayoutMode: Left;
  Padding: (Left: 8, Right: 6, Top: 4, Bottom: 4);
  Background: #0a0f16(0.38);

  $M.@IconWell {
    @Size = 32;
    @Anchor = (Right: 10);

    ItemSlot #Icon {
      Anchor: (Width: 28, Height: 28);
      ShowQualityBackground: true;
      ShowQuantity: false;
    }
  }

  Label #Name {
    FlexWeight: 1;
    Style: (...$M.@RowNameStyle, FontSize: 13);
  }

  Label #Qty {
    Anchor: (Width: 50, Right: 8);
    Style: $M.@RowSideStyle;
  }

  $C.@SmallTertiaryTextButton #Remove {
    @Text = "X";
    @Anchor = (Width: 36);
  }
}
