// Tutorial — one page of a guided walkthrough: heading, lead paragraph, the
// page's content rows, then its navigation buttons.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 580, Height: 640);

  #Title {
    Group {
      $C.@Title {
        @Text = "Tutorial";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label #PageTitle {
      Anchor: (Height: 32, Bottom: 4);
      Style: $M.@DisplayStyle;
    }

    Label #PageSubtitle {
      Anchor: (Height: 40, Bottom: 10);
      Style: $M.@BodyMutedStyle;
    }

    $M.@Hairline {
      @Anchor = (Bottom: 12);
    }

    Group #ContentList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 8);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }

    Group #ButtonList {
      LayoutMode: Top;
      Anchor: (Top: 12);
    }
  }
}
