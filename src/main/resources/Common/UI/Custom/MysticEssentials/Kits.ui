// Kits — master/detail. Each row carries its claim status; the panel shows the
// selected kit's terms with Claim as the primary action and Preview beside it.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1000, Height: 660);

  #Title {
    Group {
      $C.@Title {
        @Text = "Kits";
      }

      $M.@HeaderMeta #KitCount {
        @Width = 180;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Master: kit list ---------------------------------------------------
    Group {
      Anchor: (Width: 380);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Available Kits";
        @Anchor = (Bottom: 10);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #KitEmpty {
          Anchor: (Height: 72);
          Style: $M.@EmptyStyle;
          Text: "No kits are available to you right now.";
          Visible: false;
        }

        Group #KitList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Detail: selected kit -----------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 4);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      $M.@Panel {
        Anchor: (Bottom: 12);

        $M.@Section {
          @Text = "Selected Kit";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 8);
        }

        Label #KitName {
          Anchor: (Height: 32, Bottom: 4);
          Style: $M.@DisplayStyle;
        }

        Label #KitDescription {
          Anchor: (Bottom: 10);
          Style: $M.@BodyMutedStyle;
        }

        $M.@Hairline {
          @Anchor = (Bottom: 6);
        }

        $M.@KvRow {
          $M.@Key { @Text = "Status"; }
          Label #KitStatus { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Cooldown"; }
          Label #KitCooldown { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Playtime"; }
          Label #KitPlaytime { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Cost"; }
          Label #KitCost { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@KvRow {
          $M.@Key { @Text = "Contents"; }
          Label #KitItems { FlexWeight: 1; Style: $M.@ValueStyle; }
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44);

        $C.@TextButton #ClaimButton {
          @Text = "Claim";
          @Anchor = (Width: 170, Right: 8);
        }

        $C.@SecondaryTextButton #PreviewButton {
          @Text = "Preview";
          @Anchor = (Width: 150);
        }
      }
    }
  }
}
