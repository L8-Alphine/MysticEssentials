// Server Wiki — editor. Write on the left, see it on the right as you type.
// Larger than any vanilla page on purpose: an author needs the body, the
// toolbar and the rendered page side by side at once.
//
// The right pane has two tabs: Preview (the page rendered exactly as readers
// will see it, refreshed as the body changes) and Images (search the game's
// icons, Hyzion's, the server's own and every item; click one to add it to the
// body, right-click to make it the page's icon).
//
// The client gives the server no cursor position, so the toolbar and the image
// picker add at the end of the body. PlaceholderText stays one line with no
// escapes: the client's string reader accepts only a doubled backslash and an
// escaped quote, and a \n here is a hard parse error that takes the whole
// merged Custom UI namespace with it.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1440, Height: 860);

  #Title {
    Group {
      $C.@Title {
        @Text = "Edit Wiki Page";
      }

      $M.@HeaderMeta #EditorId {
        @Width = 300;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Writing -------------------------------------------------------------
    Group {
      Anchor: (Width: 640);
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 58, Bottom: 4);

        Group {
          FlexWeight: 2;
          LayoutMode: Top;
          Padding: (Right: 8);

          $M.@FieldLabel {
            @Text = "Title";
          }

          $C.@TextField #TitleInput {
            @Anchor = (Height: 32);
            PlaceholderText: "What this page is called";
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          $M.@FieldLabel {
            @Text = "Category";
          }

          $C.@TextField #CategoryInput {
            @Anchor = (Height: 32);
            PlaceholderText: "Guides/Combat (use / to nest)";
          }
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 58, Bottom: 4);

        Group {
          FlexWeight: 2;
          LayoutMode: Top;
          Padding: (Right: 8);

          $M.@FieldLabel {
            @Text = "Summary";
          }

          $C.@TextField #SummaryInput {
            @Anchor = (Height: 32);
            PlaceholderText: "One line shown in the page list";
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          $M.@FieldLabel {
            @Text = "Icon";
          }

          $C.@TextField #IconInput {
            @Anchor = (Height: 32);
            PlaceholderText: "Right-click one in Images";
          }
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 58, Bottom: 6);

        Group {
          FlexWeight: 2;
          LayoutMode: Top;
          Padding: (Right: 8);

          $M.@FieldLabel {
            @Text = "Tags";
          }

          $C.@TextField #TagsInput {
            @Anchor = (Height: 32);
            PlaceholderText: "Comma separated, for search";
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;

          $M.@FieldLabel {
            @Text = "View Permission";
          }

          $C.@TextField #PermissionInput {
            @Anchor = (Height: 32);
            PlaceholderText: "Blank for everyone";
          }
        }
      }

      // Structure, then colour. Each adds to the end of the body.
      Group {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 4);

        $C.@SmallSecondaryTextButton #InsertHeading {
          @Text = "H2";
          @Anchor = (Width: 60, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #InsertSubheading {
          @Text = "H3";
          @Anchor = (Width: 60, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #InsertBullet {
          @Text = "List";
          @Anchor = (Width: 74, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #InsertQuote {
          @Text = "Note";
          @Anchor = (Width: 74, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #InsertRule {
          @Text = "Line";
          @Anchor = (Width: 74, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #InsertLink {
          @Text = "Link";
          @Anchor = (Width: 74, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #InsertEmbed {
          @Text = "Embed";
          @Anchor = (Width: 88);
          Padding: (Horizontal: 6);
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 6);

        Label {
          Anchor: (Width: 62);
          Style: $M.@KeyStyle;
          Text: "Colour";
        }

        $C.@SmallSecondaryTextButton #ColourGold {
          @Text = "Gold";
          @Anchor = (Width: 78, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #ColourBlue {
          @Text = "Blue";
          @Anchor = (Width: 78, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #ColourGreen {
          @Text = "Green";
          @Anchor = (Width: 88, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #ColourRed {
          @Text = "Red";
          @Anchor = (Width: 70, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #ColourGrey {
          @Text = "Grey";
          @Anchor = (Width: 78, Right: 4);
          Padding: (Horizontal: 6);
        }

        $C.@SmallSecondaryTextButton #ColourReset {
          @Text = "Plain";
          @Anchor = (Width: 82);
          Padding: (Horizontal: 6);
        }
      }

      $C.@MultilineTextField #BodyInput {
        @Anchor = (Bottom: 6);
        FlexWeight: 1;
        PlaceholderText: "## Heading  -  - Bullet  -  > Note  -  [[page-id]] to link  -  pictures from the Images tab";
      }

      Label #EditorStatus {
        Anchor: (Height: 18, Bottom: 2);
        Style: $M.@HintStyle;
      }

      $M.@ActionBar {
        @Anchor = (Height: 44, Top: 4);

        $C.@TextButton #SaveButton {
          @Text = "Save";
          @Anchor = (Width: 130, Right: 8);
        }

        $C.@SecondaryTextButton #CancelButton {
          @Text = "Back";
          @Anchor = (Width: 120);
        }

        $M.@Spacer {}

        $C.@CancelTextButton #DeleteButton {
          @Text = "Delete";
          @Anchor = (Width: 120);
          Visible: false;
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Seeing it -----------------------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 32, Bottom: 8);

        $M.@Tab #PreviewTab {
          @Text = "Preview";
          @Anchor = (Width: 120, Right: 6);
        }

        $M.@Tab #ImagesTab {
          @Text = "Images";
          @Anchor = (Width: 120);
        }

        $M.@Spacer {}

        $C.@SmallSecondaryTextButton #RefreshPreview {
          @Text = "Refresh";
          @Anchor = (Width: 90);
        }
      }

      Group #PreviewPane {
        FlexWeight: 1;
        LayoutMode: Top;

        $M.@Well {
          FlexWeight: 1;

          Label #PreviewEmpty {
            Anchor: (Height: 80);
            Style: $M.@EmptyStyle;
            Text: "Start writing and the page appears here.";
            Visible: false;
          }

          Group #PreviewBody {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            Padding: (Right: 10, Left: 6, Top: 4);
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }
      }

      Group #ImagesPane {
        FlexWeight: 1;
        LayoutMode: Top;
        Visible: false;

        $C.@TextField #ImageSearch {
          @Anchor = (Height: 32, Bottom: 6);
          PlaceholderText: "Search every icon, item, model and texture: chest, portal, kweebec...";
        }

        // What to search. Items are drawn as item slots; the rest are images.
        Group {
          LayoutMode: Left;
          Anchor: (Height: 32, Bottom: 6);

          $M.@Tab #SourceIcons {
            @Text = "Icons";
            @Anchor = (Width: 110, Right: 6);
          }

          $M.@Tab #SourceItems {
            @Text = "Items";
            @Anchor = (Width: 110, Right: 6);
          }

          $M.@Tab #SourceModels {
            @Text = "Models";
            @Anchor = (Width: 110, Right: 6);
          }

          $M.@Tab #SourceAll {
            @Text = "All";
            @Anchor = (Width: 110);
          }
        }

        Label #ImageHint {
          Anchor: (Height: 18, Bottom: 6);
          Style: $M.@HintStyle;
        }

        $M.@Well {
          FlexWeight: 1;

          Group {
            FlexWeight: 1;
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;

            Group #Results {
              LayoutMode: LeftCenterWrap;
            }
          }
        }
      }
    }
  }
}
