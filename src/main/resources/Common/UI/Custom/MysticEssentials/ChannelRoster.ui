// Channel Roster — a slim member list for the current channel with counts and a
// jump to the full member-management page.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 400, Height: 600);

  #Title {
    Group {
      $C.@Title {
        @Text = "Channel Roster";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    $M.@Panel {
      @Padding = 14;
      Anchor: (Bottom: 12);

      Label #RosterChannel {
        Anchor: (Height: 28, Bottom: 2);
        Style: $M.@DisplaySmallStyle;
      }

      Label #RosterCounts {
        Anchor: (Height: 16);
        Style: $M.@MetaGoldStyle;
      }
    }

    $M.@Section {
      @Text = "Online Members";
      @Anchor = (Bottom: 8);
    }

    $M.@Well {
      FlexWeight: 1;

      Label #RosterEmpty {
        Anchor: (Height: 64);
        Style: $M.@EmptyStyle;
        Text: "Nobody from this channel is online right now.";
        Visible: false;
      }

      Group #MemberList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    Label #RosterMore {
      Anchor: (Height: 18, Top: 6);
      Style: $M.@CaptionStyle;
      Visible: false;
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 10);

      $C.@SecondaryTextButton #FullListButton {
        @Text = "Full Member List";
        @Anchor = (Width: 200);
      }

      $M.@Spacer {}

      $C.@TertiaryTextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 110);
      }
    }
  }
}
