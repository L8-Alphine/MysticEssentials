// Window shell for author-defined layouts.
//
// The shell only provides the chrome and two addressable anchors:
// #MysticLayoutShell for the window size (set at runtime from the document's
// width/height) and #MysticLayoutRoot, which the server fills with inline
// markup compiled from the document. Every id is mod-prefixed because Custom
// UI selectors are matched by name with nothing scoping them per document.
//
// Nothing about a layout's structure lives in this file, which is what lets an
// edited document render a new shape without shipping a new asset pack.
$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container #MysticLayoutShell {
  Anchor: (Width: 900, Height: 620);

  #Title {
    Group {
      $C.@Title #MysticLayoutTitle {
        @Text = "";
      }
    }
  }

  #CloseButton { Visible: true; }

  #Content {
    LayoutMode: Top;
    Padding: (Full: 12);

    Group #MysticLayoutRoot {
      FlexWeight: 1;
      LayoutMode: Top;
    }
  }
}
