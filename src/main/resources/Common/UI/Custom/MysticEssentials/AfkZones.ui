// AFK Zones — pick a place to wait. Plain AFK-in-place stays available below.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 540, Height: 580);

  #Title {
    Group {
      $C.@Title {
        @Text = "AFK Zones";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label {
      Anchor: (Height: 34, Bottom: 10);
      Style: $M.@BodyMutedStyle;
      Text: "Choose a zone to wait in. You will be returned to where you are standing now when you come back.";
    }

    $M.@Section {
      @Text = "Zones";
      @Anchor = (Bottom: 8);
    }

    $M.@Well {
      FlexWeight: 1;

      Label #ZonesEmpty {
        Anchor: (Height: 72);
        Style: $M.@EmptyStyle;
        Text: "No AFK zones are available to you.";
        Visible: false;
      }

      Group #ZoneList {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        Padding: (Right: 6);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    $M.@ActionBar {
      @Anchor = (Height: 44, Top: 12);

      $M.@Spacer {}

      $C.@SecondaryTextButton #AfkHereButton {
        @Text = "Just AFK Here";
        @Anchor = (Width: 190);
      }
    }
  }
}
