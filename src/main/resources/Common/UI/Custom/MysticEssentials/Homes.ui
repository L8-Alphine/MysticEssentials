// My Homes — master/detail. The list on the left is the navigation; the panel on
// the right is the selected home with its actions. Destructive Delete lives at
// the far end of the action bar, away from Teleport.
$C = "../Common.ui";
$M = "MysticTheme.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 920, Height: 640);

  #Title {
    Group {
      $C.@Title {
        @Text = "My Homes";
      }

      $M.@HeaderMeta #HomeCount {
        @Width = 160;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    // ---- Master: home list --------------------------------------------------
    Group {
      Anchor: (Width: 300);
      LayoutMode: Top;

      $M.@Section {
        @Text = "Your Homes";
        @Anchor = (Bottom: 10);
      }

      $M.@Well {
        FlexWeight: 1;

        Label #HomesEmpty {
          Anchor: (Height: 72);
          Style: $M.@EmptyStyle;
          Text: "You have no homes yet. Set one below, or use /sethome <name>.";
          Visible: false;
        }

        Group #HomeList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          Padding: (Right: 6);
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }
    }

    $M.@ColumnDivider {}

    // ---- Detail: selected home ----------------------------------------------
    Group {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      Padding: (Right: 4);
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      $M.@Panel {
        Anchor: (Bottom: 12);

        $M.@Section {
          @Text = "Selected Home";
          @Style = $M.@EyebrowGoldStyle;
          @Anchor = (Bottom: 8);
        }

        Label #SelectedHome {
          Anchor: (Height: 32, Bottom: 6);
          Style: $M.@DisplayStyle;
        }

        $M.@Hairline {
          @Anchor = (Bottom: 6);
        }

        $M.@KvRow {
          $M.@Key { @Text = "Location"; }
          Label #HomeWorld { FlexWeight: 1; Style: $M.@ValueStyle; }
        }

        $M.@Hairline {
          @Anchor = (Top: 6, Bottom: 12);
        }

        $M.@FieldLabel {
          @Text = "Rename";
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44);

          $C.@TextField #RenameInput {
            @Anchor = (Vertical: 3, Right: 8);
            FlexWeight: 1;
            PlaceholderText: "New name";
          }

          $C.@SecondaryTextButton #RenameButton {
            @Text = "Rename";
            @Anchor = (Width: 130);
          }
        }
      }

      $M.@ActionBar {
        @Anchor = (Height: 44, Bottom: 18);

        $C.@TextButton #TeleportButton {
          @Text = "Teleport";
          @Anchor = (Width: 170, Right: 8);
        }

        $C.@SecondaryTextButton #MoveHereButton {
          @Text = "Move Here";
          @Anchor = (Width: 150);
        }

        $M.@Spacer {}

        $C.@CancelTextButton #DeleteButton {
          @Text = "Delete";
          @Anchor = (Width: 120);
        }
      }

      $M.@Section {
        @Text = "Set a New Home";
        @Anchor = (Bottom: 6);
      }

      Label {
        Anchor: (Height: 18, Bottom: 8);
        Style: $M.@CaptionStyle;
        Text: "Saves where you are standing right now under a new name.";
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44);

        $C.@TextField #NewHomeName {
          @Anchor = (Vertical: 3, Right: 8);
          FlexWeight: 1;
          PlaceholderText: "Home name";
        }

        $C.@SecondaryTextButton #CreateHomeButton {
          @Text = "Set Home";
          @Anchor = (Width: 140);
        }
      }
    }
  }
}
