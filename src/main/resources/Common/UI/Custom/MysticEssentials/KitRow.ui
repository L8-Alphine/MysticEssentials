// Row template for the kit list. Appended per entry:
//   cmd.append("#KitList", "MysticEssentials/KitRow.ui")
// and populated by index: cmd.set("#KitList[i] #Name.TextSpans", ...).
// #RowIcon is set by the server; #Selected marks the current selection.
$M = "MysticTheme.ui";

Button #Row {
  Anchor: (Height: 56, Bottom: 4);
  Style: $M.@RowStyle;
  LayoutMode: Full;

  $M.@RowSelection #Selected {
    @Height = 56;
  }

  Group {
    Anchor: (Full: 0);
    LayoutMode: Left;
    Padding: (Left: 12, Right: 12, Top: 10, Bottom: 10);

    $M.@IconWell {
      @Anchor = (Right: 12);

      // The kit's items, cycled by the server while the page is open.
      ItemSlot #RowItem {
        Anchor: (Width: 32, Height: 32);
        ShowQualityBackground: false;
        ShowQuantity: false;
        Visible: false;
      }

      // Vanilla icon (Common-rooted AssetPath), set by the server.
      AssetImage #RowIcon {
        Anchor: (Width: 22, Height: 22);
        AssetPath: "";
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
        Visible: false;
      }
    }

    Group {
      LayoutMode: Top;
      FlexWeight: 1;

      Label #Name {
        Anchor: (Height: 20, Bottom: 2);
        Style: $M.@RowNameStyle;
      }

      Label #Meta {
        Anchor: (Height: 14);
        Style: $M.@RowMetaStyle;
      }
    }

    Label #Status {
      Anchor: (Width: 120, Left: 8);
      Style: $M.@RowSideStyle;
    }
  }
}
