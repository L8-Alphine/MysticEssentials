// Mystic Essentials persistent notification banner — the boss-bar equivalent.
//
// Pinned near the top of the screen so a countdown or emergency stays readable
// while the player keeps playing. Critical alerts use this so the information
// survives the moment a title fades.
//
// The accent spine and the progress fill are recoloured/resized at runtime:
// #MysticNotificationBannerFill / #MysticNotificationBannerRest carry
// complementary flex weights for the remaining fraction.
Group #MysticNotificationBannerRoot {
  Anchor: (Top: 64, Left: 0, Right: 0, Height: 56);
  LayoutMode: CenterMiddle;

  Group #MysticNotificationBannerPanel {
    Anchor: (Width: 640, Height: 52);
    Background: #0a0f16(0.72);
    LayoutMode: Left;

    Group #MysticNotificationBannerAccent {
      Anchor: (Width: 4, Height: 52);
      Background: #FF4B4B;
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Left: 14, Right: 14, Top: 8, Bottom: 8);

      Group {
        LayoutMode: Left;
        Anchor: (Height: 22, Bottom: 6);

        Label #MysticNotificationBannerText {
          FlexWeight: 1;
          Style: (FontSize: 16, RenderBold: true, TextColor: #ffffff, VerticalAlignment: Center);
        }

        Label #MysticNotificationBannerHint {
          Anchor: (Width: 140);
          Style: (FontSize: 11, RenderUppercase: true, LetterSpacing: 1, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center);
        }
      }

      Group #MysticNotificationBannerTrack {
        LayoutMode: Left;
        Anchor: (Height: 6);
        Background: #ffffff(0.08);

        Group #MysticNotificationBannerFill {
          FlexWeight: 100;
          Background: #FF4B4B;
        }

        Group #MysticNotificationBannerRest {
          FlexWeight: 0;
        }
      }
    }
  }
}
