// Mystic Essentials teleport warmup indicator.
//
// Matches the MysticVanish HUD placement so short status text appears above the
// hotbar/mana region without opening a modal page.
Group #TeleportWarmupHudRoot {
  Anchor: (Bottom: 230, Left: 0, Right: 0, Height: 40);
  LayoutMode: CenterMiddle;

  Group #TeleportWarmupPanel {
    Background: #0a0f16(0.55);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 3, Height: 34);
      Background: #E8A93B;
    }

    Group {
      Padding: (Left: 14, Right: 16, Vertical: 6);
      LayoutMode: CenterMiddle;

      Label #MysticWarmupStatus {
        Style: (FontSize: 17, TextColor: #ffffff, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
      }
    }
  }
}
