// One tile of the shortcut rail. Appended once per slot into
// #MysticShortcutRailSlots; the server addresses each by index
// (`#MysticShortcutRailSlots[0] #MysticSlotGlyph.TextSpans`).
//
// States, per the bible's ShortcutHUDItem contract:
//   active       — #MysticSlotActive visible: gold edge + gold glyph
//   unavailable  — #MysticSlotGlyph/#MysticSlotNumber dimmed by the server
//   separator    — #MysticSlotSeparator visible after the channel block (4)
//                  and after the services block (6)
//
// EVERY construct here is one the shipped corpus already uses. This document
// is appended at join, and a client that rejects it drops the whole merged
// Custom UI namespace -- which takes other mods' Hud/ documents down with it,
// so the error names their file, not ours. Nothing novel belongs in here:
//
//   * borders are nested plain Groups, not OutlineColor/OutlineSize (which
//     vanilla uses once in its entire corpus, and this mod never did before);
//   * no TooltipText and no HitTestVisible (zero vanilla uses, and pointless
//     besides -- CustomHud carries no event bindings, so a HUD never receives
//     a hover in the first place);
//   * HorizontalAlignment, not the bare Alignment.
//
// Colour literals rather than a theme import: see the header of
// MysticEssentialsShortcutRail.ui for why an always-on overlay carries no
// cross-document reference.
Group {
  Anchor: (Width: 46, Height: 46, Bottom: 5);

  // Base plate.
  Group {
    Anchor: (Full: 0);
    Background: #0b1422(0.72);
  }

  // Resting edge, drawn as four hairlines rather than an outline property.
  Group {
    Anchor: (Left: 0, Top: 0, Right: 0, Height: 1);
    Background: #3a506b(0.55);
  }

  Group {
    Anchor: (Left: 0, Bottom: 1, Right: 0, Height: 1);
    Background: #3a506b(0.55);
  }

  // Selected/active channel: a gold wash plus the gold edge below, never
  // colour alone -- the glyph recolours to gold as well.
  Group #MysticSlotActive {
    Anchor: (Full: 0);
    Background: #d9b572(0.16);
    Visible: false;
  }

  // Active marker on the inner edge, mirroring the reference's gold bar.
  Group #MysticSlotBar {
    Anchor: (Left: 0, Top: 11, Width: 3, Height: 24);
    Background: #d9b572;
    Visible: false;
  }

  // Icon glyph. Short text rather than a texture: the mod ships no PNGs, and a
  // missing TexturePath in an always-on overlay would break the document.
  Group {
    Anchor: (Full: 0);
    LayoutMode: CenterMiddle;

    Label #MysticSlotGlyph {
      Style: (
        FontName: "Secondary",
        FontSize: 17,
        RenderBold: true,
        RenderUppercase: true,
        TextColor: #aec1d5,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }
  }

  // Slot number, always legible so the shortcut stays discoverable.
  Label #MysticSlotNumber {
    Anchor: (Right: 4, Top: 2, Width: 12, Height: 12);
    Style: (
      FontSize: 10,
      RenderBold: true,
      TextColor: #93a8c0,
      HorizontalAlignment: End,
      VerticalAlignment: Center
    );
  }

  // Group divider, drawn under the tile it closes.
  Group #MysticSlotSeparator {
    Anchor: (Left: 6, Right: 6, Bottom: 0, Height: 1);
    Background: #3a506b(0.55);
    Visible: false;
  }
}
