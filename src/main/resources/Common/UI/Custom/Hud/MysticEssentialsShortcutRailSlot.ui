// One tile of the shortcut rail. Appended once per slot into
// #MysticShortcutRailSlots; the server addresses each by its child index.
//
// States, per the bible's ShortcutHUDItem contract:
//   active       — #MysticSlotActive + #MysticSlotBar: gold wash and gold edge
//   unavailable  — #MysticSlotDim veils the icon; the number dims too
//   icon         — #MysticSlotIcon, a vanilla icon set by AssetPath at runtime;
//                  slots configured without one show #MysticSlotGlyph instead
//
// This document is appended at join, and a client that rejects it drops the
// whole merged Custom UI namespace -- other mods' documents included. So every
// construct here is one a shipped document already uses at join. The icon
// element is copied in form from Endgame & QoL's always-on KeyHintsHud.ui
// (AssetImage, Anchor Full, empty AssetPath set at runtime); that HUD sets no
// FallbackTexturePath, so neither does this one.
//
// Sizes are mirrored in ShortcutRailHud (TILE, GAP): change them together.
Group {
  Anchor: (Width: 34, Height: 34, Bottom: 4);

  // Base plate.
  Group {
    Anchor: (Full: 0);
    Background: #0b1422(0.72);
  }

  // Resting edge.
  Group {
    Anchor: (Left: 0, Top: 0, Right: 0, Height: 1);
    Background: #3a506b(0.55);
  }

  Group {
    Anchor: (Left: 0, Bottom: 0, Right: 0, Height: 1);
    Background: #3a506b(0.55);
  }

  // Active channel: gold wash plus a gold edge, never colour alone.
  Group #MysticSlotActive {
    Anchor: (Full: 0);
    Background: #d9b572(0.16);
    Visible: false;
  }

  Group #MysticSlotBar {
    Anchor: (Left: 0, Top: 8, Width: 2, Height: 18);
    Background: #d9b572;
    Visible: false;
  }

  // Vanilla icon, centred.
  Group {
    Anchor: (Full: 0);
    LayoutMode: CenterMiddle;

    Group {
      Anchor: (Width: 20, Height: 20);

      AssetImage #MysticSlotIcon {
        Anchor: (Full: 0);
        AssetPath: "";
      }
    }
  }

  // Letter mark for a slot configured without an icon.
  Group {
    Anchor: (Full: 0);
    LayoutMode: CenterMiddle;

    Label #MysticSlotGlyph {
      Style: (
        FontName: "Secondary",
        FontSize: 13,
        RenderBold: true,
        RenderUppercase: true,
        TextColor: #aec1d5,
        HorizontalAlignment: Center,
        VerticalAlignment: Center
      );
    }
  }

  // Out of reach: an icon cannot be recoloured, so it is veiled instead.
  Group #MysticSlotDim {
    Anchor: (Full: 0);
    Background: #0b1422(0.6);
    Visible: false;
  }

  // Slot number, drawn last so it stays legible over the veil.
  Label #MysticSlotNumber {
    Anchor: (Right: 2, Top: 1, Width: 10, Height: 10);
    Style: (
      FontSize: 8,
      RenderBold: true,
      TextColor: #93a8c0,
      HorizontalAlignment: End,
      VerticalAlignment: Center
    );
  }
}
